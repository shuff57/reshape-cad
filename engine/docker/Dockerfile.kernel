# syntax=docker/dockerfile:1
# ============================================================================
# engine/docker/Dockerfile.kernel
#
# Headless FreeCAD kernel wasm build (Track A2 spike, G2-G4).
#
# Builds FROM the consolidated toolchain image (engine/docker/Dockerfile.toolchain,
# target `toolchain`, tagged reshape-cad/fc-toolchain:latest).
#
# Source: shallow clone of github.com/magik6k/freecad-web pinned to commit
# 24053dfb (per the A2 brief). U2 later moves this onto tag 1.1.3 -- this
# Dockerfile intentionally hardcodes the pinned sha, not a branch, so a
# rebuild is reproducible.
#
# G2 uses the PROVEN minimal module set from deps/build/configure-stage1.sh
# (Part, Sketcher, Material; BUILD_GUI=OFF) reproduced against OUR toolchain
# paths. The brief's full module list (PartDesign, TechDraw, Spreadsheet,
# Draft) is deps/README.md section 2's set with GUI-only pieces stripped --
# team-lead confirmed upstream built these on wasm (commits 80046491,
# 84216dec, e7fb8876), so this is a *reproduction* with BUILD_GUI=OFF, not
# unproven territory. Toggle EXTRA_MODULES below once the minimal set
# passes G2-G4.
# ============================================================================

FROM reshape-cad/fc-toolchain:latest AS kernel-src

ARG FREECAD_WEB_SHA=24053dfb8d3f3a8a31d19af6bdc0a0783f403f54
WORKDIR /work
RUN git clone --filter=blob:none --no-checkout https://github.com/magik6k/freecad-web.git fw \
    && cd fw && git checkout "${FREECAD_WEB_SHA}"

# ----------------------------------------------------------------------------
# configure: G2. Toolchain prefixes point at our /opt/toolchains layout
# (built in Dockerfile.toolchain) rather than upstream's /opt/toolchains
# (same root, different internal contents -- ours has no qt-jspi, no PySide,
# no VTK/Coin3D/Fem; Qt6_DIR points at the aqt prebuilt wasm_singlethread,
# QT_HOST_PATH at its matching gcc_64 host tools).
# ----------------------------------------------------------------------------
FROM kernel-src AS kernel-configure
ENV TC=/opt/toolchains
# KERNEL_LINKER_FLAGS is empty by default (normal -O3 link). It exists solely
# as a debug lever for the G3 "[parse exception: popping from empty stack]"
# investigation -- see the NOTE above kernel-build below -- and should stay
# empty on any build meant to ship. Do not bake a permanent -O0/-O1 default
# in here; that regressed OCCT runtime perf once already (commit a13bc8f)
# and was reverted for the 4.0.15 bump.
ARG KERNEL_LINKER_FLAGS=""
ENV SY=/emsdk/upstream/emscripten/cache/sysroot
WORKDIR /work/fw
# FreeCAD's root CMakeLists unconditionally does `find_package(ZLIB
# REQUIRED)` (and Main/CMakeLists.txt links -sUSE_ZLIB=1 -sUSE_BZIP2=1) --
# these are emscripten "ports" built lazily on first *compile* use, but
# find_package needs the .a to already exist on disk at *configure* time.
# freetype/harfbuzz: FREECAD_USE_FREETYPE=OFF (my first guess, reasoning
# from OCCT's own optional font support) was wrong -- FreeCAD's Part module
# unconditionally `#include <ft2build.h>` in Geometry.cpp regardless of that
# flag, confirmed by an actual "fatal error: 'ft2build.h' file not found"
# partway through the ninja build (642/714 objects in). Matches upstream's
# own configure-stage1.sh, which always turns FREECAD_USE_FREETYPE=ON.
RUN embuilder build zlib bzip2 sqlite3
# freetype/harfbuzz must ALSO be built with our wasm-EH flags: a plain
# `embuilder build freetype` (no EH flags) produced a libfreetype.a that
# calls the legacy JS-based `emscripten_longjmp`, which does not exist
# in a wasm-EH final link (which wants `__wasm_longjmp` instead, per
# FreeCAD's own CMakeLists.txt comment on -sSUPPORT_LONGJMP=wasm) --
# confirmed by an actual "undefined symbol: emscripten_longjmp" kernel
# link failure. `embuilder --force build` with EMCC_CFLAGS set did NOT
# fix this (it "rebuilt" in ~4s, too fast to be real, and produced the
# identical broken symbol -- embuilder.py evidently does not route this
# env var into its own internal build calls the way plain `emcc` does).
# Forcing a real on-demand port (re)build through an actual emcc
# invocation with the matching settings -- the same code path FreeCAD's
# own compile would trigger -- picks up the correct wasm-longjmp variant.
# NOTE: with these settings active, emscripten caches freetype under a
# DIFFERENT filename, libfreetype-legacysjlj.a, not plain libfreetype.a
# (confirmed by the actual build log: "generating port:
# sysroot/lib/wasm32-emscripten/libfreetype-legacysjlj.a"). harfbuzz has
# no such variant suffix (it doesn't use longjmp). FreeCAD's configure
# below points FREETYPE_LIBRARY at the suffixed name accordingly.
RUN echo 'int main(){return 0;}' > /tmp/eh_probe.c \
    && emcc /tmp/eh_probe.c -sUSE_FREETYPE=1 -sUSE_HARFBUZZ=1 \
         ${EM_WASM_EH_FLAGS} -sSUPPORT_LONGJMP=wasm -o /tmp/eh_probe.js \
    && test -f "$SY/lib/wasm32-emscripten/libfreetype-legacysjlj.a" \
    && test -f "$SY/lib/wasm32-emscripten/libharfbuzz.a"
# Eigen3 is header-only and only needed here (not by any wasm dependency),
# so install it in this Dockerfile rather than the toolchain base image.
RUN apt-get update && apt-get install -y --no-install-recommends libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*
# DEVIATION FROM UPSTREAM in the two flags right below, confirmed
# necessary by an actual link failure: configure-stage1.sh compiles
# FreeCAD's own sources with plain `-fexceptions`, which under Emscripten
# defaults to the OLD JS-exception-based runtime ABI (__resumeException,
# llvm_eh_typeid_for) -- a DIFFERENT set of runtime support functions from
# the new wasm-EH ABI, not just a different bytecode encoding of the same
# one. Our OCCT/Boost/Xerces/CPython are all built with -fwasm-exceptions
# (the new ABI), so the final link picked the new ABI's runtime libraries
# (em++'s automatic selection), leaving FreeCADMainCmd.dir/MainCmd.cpp.o's
# legacy-ABI calls with no matching symbols: "undefined symbol:
# __resumeException" / "undefined symbol: llvm_eh_typeid_for". The
# mandatory wasm-opt --translate-to-exnref pass normalizes
# *legacy-vs-exnref wasm-EH opcodes* post-link; it cannot fix a link
# against the wrong runtime ABI entirely. Likely explanation for
# upstream's own `-fexceptions`-everywhere recipe: their whole toolchain
# (including their OCCT) was built consistently with legacy EH, then
# normalized to exnref in one pass at the end -- we built OCCT/Boost/etc
# with the new ABI directly instead, so FreeCAD's own code has to match
# that, not upstream's literal flag.
RUN emcmake cmake -S . -B /work/build -G Ninja \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=$TC/freecad-dist \
      -DFREECAD_WASM_NODERAWFS=ON \
      -DCMAKE_FIND_ROOT_PATH="$TC/qt-wasm;$TC/occt-wasm;$TC/xerces-wasm;$TC/fmt-wasm;$TC/yaml-wasm;$TC/python-wasm;$TC/boost-wasm;$TC/icu-wasm;$TC" \
      -DCMAKE_CXX_FLAGS="-fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0 -DEIGEN_DONT_VECTORIZE -DBOOST_HAS_PTHREADS=1 -DBOOST_STACKTRACE_USE_NOOP" \
      -DCMAKE_C_FLAGS="-fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0" \
      -DFREECAD_QT_MAJOR_VERSION=6 \
      -DQt6_DIR=$TC/qt-wasm/lib/cmake/Qt6 \
      -DQT_HOST_PATH=$TC/qt-host \
      -DPython3_EXECUTABLE=$TC/python-wasm-native/bin/python3.14 \
      -DPython3_INCLUDE_DIR=$TC/python-wasm/include/python3.14 \
      -DPython3_LIBRARY=$TC/python-wasm/lib/libpython3.14.a \
      "-DFREECAD_WASM_EXTRA_LINK_LIBS=$TC/python-wasm/lib/libmpdec.a;$TC/python-wasm/lib/libffi.a;$TC/python-wasm/lib/libHacl.a;$TC/python-wasm/lib/libexpat.a;$SY/lib/wasm32-emscripten/libsqlite3.a;$TC/icu-wasm/lib/libicudata.a" \
      -DBoost_DIR=$TC/boost-wasm/lib/cmake/Boost-1.86.0 \
      -DEIGEN3_INCLUDE_DIR=/usr/include/eigen3 \
      -DXercesC_INCLUDE_DIR=$TC/xerces-wasm/include \
      -DXercesC_LIBRARY=$TC/xerces-wasm/lib/libxerces-c.a \
      -Dfmt_DIR=$TC/fmt-wasm/lib/cmake/fmt \
      -DOpenCASCADE_DIR=$TC/occt-wasm/lib/cmake/opencascade \
      -Dyaml-cpp_DIR=$TC/yaml-wasm/lib/cmake/yaml-cpp \
      -DICU_ROOT=$TC/icu-wasm \
      -DZLIB_INCLUDE_DIR=$SY/include \
      -DZLIB_LIBRARY=$SY/lib/wasm32-emscripten/libz.a \
      -DBUILD_GUI=OFF \
      -DBUILD_PART=ON -DBUILD_SKETCHER=ON -DBUILD_MATERIAL=ON \
      -DBUILD_PART_DESIGN=OFF -DBUILD_SPREADSHEET=OFF -DBUILD_START=OFF \
      -DBUILD_MEASURE=OFF -DBUILD_MESH=OFF -DBUILD_MESH_PART=OFF \
      -DBUILD_IMPORT=OFF -DBUILD_DRAFT=OFF -DBUILD_BIM=OFF -DBUILD_CAM=OFF \
      -DBUILD_FEM=OFF -DBUILD_TECHDRAW=OFF -DBUILD_ASSEMBLY=OFF -DBUILD_ROBOT=OFF \
      -DBUILD_SURFACE=OFF -DBUILD_POINTS=OFF -DBUILD_INSPECTION=OFF \
      -DBUILD_REVERSEENGINEERING=OFF -DBUILD_OPENSCAD=OFF -DBUILD_PLOT=OFF \
      -DBUILD_SHOW=OFF -DBUILD_TUX=OFF -DBUILD_WEB=OFF -DBUILD_HELP=OFF \
      -DBUILD_ADDONMGR=OFF -DBUILD_JTREADER=OFF -DBUILD_TEST=OFF -DBUILD_FLAT_MESH=OFF \
      -DBUILD_DYNAMIC_LINK_PYTHON=OFF -DENABLE_DEVELOPER_TESTS=OFF \
      -DFREECAD_USE_PYSIDE=OFF -DFREECAD_USE_SHIBOKEN=OFF \
      -DFREECAD_USE_PCL=OFF -DFREECAD_USE_FREETYPE=ON \
      -DFREETYPE_INCLUDE_DIR_ft2build=$SY/include/freetype2 \
      -DFREETYPE_INCLUDE_DIR_freetype2=$SY/include/freetype2 \
      -DFREETYPE_LIBRARY=$SY/lib/wasm32-emscripten/libfreetype-legacysjlj.a \
      -DHARFBUZZ_INCLUDE_DIR=$SY/include/harfbuzz \
      -DHARFBUZZ_LIBRARY=$SY/lib/wasm32-emscripten/libharfbuzz.a \
      -DFREECAD_USE_PYBIND11=OFF \
      -DCMAKE_EXE_LINKER_FLAGS="${KERNEL_LINKER_FLAGS}"

# ----------------------------------------------------------------------------
# build: G3. ninja + the mandatory wasm-opt exnref normalization.
# ----------------------------------------------------------------------------
FROM kernel-configure AS kernel-build
# NOTE: the ninja target is `FreeCADCmd.js`, not `FreeCADCmd` -- confirmed
# via `ninja -t targets` after the FreeCADCmd guess failed ("did you mean
# 'FreeCAD.a'?"). The underlying executable target is `FreeCADMainCmd`, and
# its actual output files are bin/FreeCADCmd.js / bin/FreeCADCmd.wasm (not
# "FreeCAD.js"/"FreeCAD.wasm" -- an earlier version of this file had that
# wrong and failed at the wasm-opt step below with "Failed opening
# '.../FreeCAD.wasm'" since the file never existed under that name).
#
# NOTE (CORRECTED -- the previous version of this comment was wrong): this
# build previously carried -DCMAKE_EXE_LINKER_FLAGS="-O1 -g" to work around
# emscripten's own internal post-link wasm-opt pass (`--post-emscripten -O3
# ... --enable-exception-handling`, part of every em++ link at -O3) failing
# to parse the freshly linked module with "[parse exception: popping from
# empty stack]". That failure was originally attributed to a clang-22 OCCT
# miscompile in ChFi3d_Builder::Compute() (named by V8 under an -O1 -g
# isolated repro), allegedly fixed by bumping EMSDK_VERSION to 4.0.12 ->
# 4.0.15. THAT DIAGNOSIS DID NOT HOLD UP: after the full 4.0.15 rebuild with
# the -O1/-O0/-fno-jump-tables workarounds removed, the IDENTICAL failure
# recurred at the real kernel link (byte offset ~24.1M, same signature).
# Three separate isolated re-tests (kitchen-sink relinks of OCCT+Xerces+
# ICU+Boost+fmt+yaml-cpp, +Qt 6.11.1, +CPython 3.14.4, all against the
# rebuilt 4.0.15 toolchain) all loaded clean in
# `node --experimental-wasm-exnref` -- but those tests are THEMSELVES
# suspect: none of them called into the linked code, so wasm-ld's default
# --gc-sections stripped everything unreachable, including
# ChFi3d_Builder::Compute (confirmed absent via `llvm-nm --defined-only`
# even with -g) -- the "Module OK" results proved nothing about that
# function specifically. Root cause is UNKNOWN as of this writing; do not
# trust an isolated relink's "Module OK" as evidence unless you have
# independently confirmed (via `llvm-nm`/`wasm-dis` on the *named* function)
# that gc-sections did not just delete the thing under test.
#
# Debug lever: KERNEL_LINKER_FLAGS (ARG, above) lets you pass e.g.
# `--build-arg KERNEL_LINKER_FLAGS="-O0 -g"` to make this link skip
# emscripten's internal post-link wasm-opt pass entirely (it only runs at
# link-time -O>0), producing a real bin/FreeCADCmd.wasm to inspect even
# when the -O3 link fails here. Corroborate any V8-named function with an
# independent tool before acting on it: `wasm-opt --debug` on the raw
# (pre-any-wasm-opt) linked module prints the last opcode read and its
# enclosing function; `wasm-objdump`/`llvm-objdump -d` can map the parse
# error's byte offset directly.
RUN ninja -C /work/build FreeCADCmd.js -j"$(nproc)"

FROM kernel-build AS kernel-linked

FROM kernel-linked AS kernel-build-final
RUN /emsdk/upstream/bin/wasm-opt \
      --translate-to-exnref --emit-exnref --all-features -g \
      /work/build/bin/FreeCADCmd.wasm -o /work/build/bin/FreeCADCmd.wasm

FROM scratch AS kernel-artifacts
COPY --from=kernel-build-final /work/build/bin/FreeCADCmd.js /
COPY --from=kernel-build-final /work/build/bin/FreeCADCmd.wasm /
