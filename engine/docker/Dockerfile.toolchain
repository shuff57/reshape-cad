# syntax=docker/dockerfile:1
# ============================================================================
# engine/docker/Dockerfile.toolchain
#
# Headless FreeCAD -> WebAssembly toolchain image (Track A2 spike).
# NO Qt Widgets/GUI, NO Coin3D, NO PySide6, NO VTK.
#
# One stage per dependency so `docker build` layer-caches independently:
# a failed later stage does not force a rebuild of earlier ones.
#
# All wasm deps compiled with the SAME exception model:
#   -fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0
# (mixing legacy and exnref EH in one linked module is rejected by V8 -- see
# the wasm-opt --translate-to-exnref step in Dockerfile.kernel / build.sh).
#
# Versions pinned here (OCCT/Xerces/ICU/fmt/yaml-cpp are NOT pinned by
# upstream freecad-web's deps/README.md -- only Boost 1.86.0 and CPython
# 3.14 are upstream-specified). Report flags any version chosen by us.
#
# EMSDK_VERSION is 4.0.15, not upstream's recorded 4.0.12 (kept for other
# reasons -- 4.0.12 was never confirmed to matter for the bug below).
#
# CORRECTED (the previous version of this comment was wrong on the root
# cause and the fix): clang-22 miscompiles 8 specific OCCT translation
# units at -O3 with new wasm-EH (-fwasm-exceptions
# -sWASM_LEGACY_EXCEPTIONS=0) -- their try_table lowering for deeply
# nested try/catch produces a spec-invalid `br_table` ("label arity
# inconsistent with previous arity 0") that V8 rejects. This was
# originally attributed to a single function (ChFi3d_Builder::Compute())
# and believed fixed by the 4.0.12->4.0.15 bump; a full rebuild proved
# that wrong (identical failure recurred), and the "fix" was actually a
# vacuous isolated test (--gc-sections had stripped the function under
# test, so it was never exercised). NONE of -O3/-O1/-O0/-fno-jump-tables,
# at any scope (single-TU or whole-OCCT), fix this -- optimization level
# is not the lever. A legacy-EH recompile of the 8 affected TUs fixes 6
# of them but leaves 2 (ShapeCustom_BSplineRestriction,
# ShapeUpgrade_ShapeDivide) unparseable even under legacy EH -- the bug
# is not exclusive to the new try_table encoding either.
#
# The fix that works for all 8, uniformly: -fignore-exceptions (see
# occt-eh-fixups.sh, applied in the occt-wasm stage below). See
# engine/docs/toolchain.md and engine/docs/spike-report.md for the full
# G3 investigation and the V8-direct-load debugging technique
# (`node --experimental-wasm-exnref -e "new WebAssembly.Module(buf)"`,
# far more informative than wasm-opt's own opaque
# "[parse exception: popping from empty stack]").
ARG EMSDK_VERSION=4.0.15
ARG OCCT_VERSION=7.8.1
ARG OCCT_SHA256=7321af48c34dc253bf8aae3f0430e8cb10976961d534d8509e72516978aa82f5
ARG BOOST_VERSION=1.86.0
ARG BOOST_SHA256=2575e74ffc3ef1cd0babac2c1ee8bdb5782a0ee672b1912da40e5b4b591ca01f
ARG XERCES_VERSION=3.2.5
ARG XERCES_SHA256=545cfcce6c4e755207bd1f27e319241e50e37c0c27250f11cda116018f1ef0f5
ARG ICU_VERSION=76-1
ARG ICU_SHA256=dfacb46bfe4747410472ce3e1144bf28a102feeaa4e3875bac9b4c6cf30f4f3e
ARG FMT_VERSION=11.0.2
ARG FMT_SHA256=6cb1e6d37bdcb756dbbe59be438790db409cdb4868c66e888d5df9f13f7c027f
ARG YAMLCPP_VERSION=0.8.0
ARG YAMLCPP_SHA256=fbe74bbdcee21d656715688706da3c8becfd946d92cd44705cc6098bb23b3a16
# 3.14.4, not 3.14.0: confirmed from freecad-web's own
# deps/build/assemble-python-prefix.sh (PYSRC=.../src/Python-3.14.4), the
# only place upstream's exact CPython version is recorded.
ARG PYTHON_VERSION=3.14.4
ARG PYTHON_SHA256=b4c059d5895f030e7df9663894ce3732bfa1b32cd3ab2883980266a45ce3cb3b
ARG LIBFFI_VERSION=3.4.6
ARG LIBFFI_SHA256=b0dea9df23c863a7a50e825440f3ebffabd65df1497108e5d437747843895a4e
ARG MPDEC_VERSION=4.0.1
ARG MPDEC_SHA256=96d33abb4bb0070c7be0fed4246cd38416188325f820468214471938545b1ac8
# Matches upstream's qt-jspi/6.11.1 and qt/6.11.1 prefixes in deps/README.md
# and configure-stage1.sh -- the one version this stage is NOT our own guess.
ARG QT_VERSION=6.11.1
ARG QTBASE_SHA256=d9594a31228aa23ad6b531719a29b45f0f3989fe6c136d45767ea179f233c1ac
ARG QTTOOLS_SHA256=8e61835a679c93fa9c6065b142353c2071ba68e297898937c32a03777fcaf50d

# ----------------------------------------------------------------------------
# base: emsdk 4.0.15 + host build tooling
# ----------------------------------------------------------------------------
FROM emscripten/emsdk:${EMSDK_VERSION} AS base
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    EM_WASM_EH_FLAGS="-fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0"
RUN apt-get update && apt-get install -y --no-install-recommends \
        ninja-build swig autoconf automake libtool pkg-config \
        python3-dev python3-pip bison flex ca-certificates curl xz-utils \
        build-essential git perl \
        qt6-base-dev qt6-tools-dev qt6-tools-dev-tools qt6-l10n-tools \
        zlib1g-dev libssl-dev libbz2-dev libffi-dev libreadline-dev \
        libsqlite3-dev liblzma-dev uuid-dev \
    && rm -rf /var/lib/apt/lists/*
# Host Qt6 (native x86_64) provides QT_HOST_PATH tools (moc, lrelease) for
# cross-compiling the wasm-target Qt6Core used by the headless kernel --
# FreeCAD's SetupQt.cmake requires Qt6 Core/Concurrent/Network/Xml even with
# BUILD_GUI=OFF (LinguistTools too, for qt_add_translation on Emscripten).
RUN mkdir -p /opt/toolchains && \
    ln -s /usr/lib/qt6 /opt/toolchains/qt-host
WORKDIR /work

# ----------------------------------------------------------------------------
# fmt-wasm: {fmt} static, wasm-EH consistent
# ----------------------------------------------------------------------------
FROM base AS fmt-wasm
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG FMT_VERSION
ARG FMT_SHA256
RUN curl -fsSL "https://github.com/fmtlib/fmt/archive/refs/tags/${FMT_VERSION}.tar.gz" \
      -o fmt.tar.gz && echo "${FMT_SHA256}  fmt.tar.gz" | sha256sum -c - \
    && tar xf fmt.tar.gz && mv "fmt-${FMT_VERSION}" fmt-src
RUN emcmake cmake -S fmt-src -B fmt-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/toolchains/fmt-wasm \
      -DFMT_TEST=OFF -DFMT_DOC=OFF \
      -DCMAKE_CXX_FLAGS="${EM_WASM_EH_FLAGS}" \
    && ninja -C fmt-build install \
    && rm -rf fmt.tar.gz fmt-src fmt-build

# ----------------------------------------------------------------------------
# yamlcpp-wasm: yaml-cpp static, wasm-EH consistent
# ----------------------------------------------------------------------------
FROM base AS yamlcpp-wasm
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG YAMLCPP_VERSION
ARG YAMLCPP_SHA256
RUN curl -fsSL "https://github.com/jbeder/yaml-cpp/archive/refs/tags/${YAMLCPP_VERSION}.tar.gz" \
      -o yamlcpp.tar.gz && echo "${YAMLCPP_SHA256}  yamlcpp.tar.gz" | sha256sum -c - \
    && tar xf yamlcpp.tar.gz && mv "yaml-cpp-${YAMLCPP_VERSION}" yamlcpp-src
RUN emcmake cmake -S yamlcpp-src -B yamlcpp-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/toolchains/yaml-wasm \
      -DYAML_CPP_BUILD_TESTS=OFF -DYAML_CPP_BUILD_TOOLS=OFF -DYAML_CPP_BUILD_CONTRIB=OFF \
      -DYAML_BUILD_SHARED_LIBS=OFF \
      -DCMAKE_CXX_FLAGS="${EM_WASM_EH_FLAGS}" \
    && ninja -C yamlcpp-build install \
    && rm -rf yamlcpp.tar.gz yamlcpp-src yamlcpp-build

# ----------------------------------------------------------------------------
# icu-wasm: ICU static, cross-built (host ICU first for the build-time tools
# genrb/gencnval/gennorm2/icupkg that the target configure needs at build
# time -- ICU's own --with-cross-build= mechanism).
# ----------------------------------------------------------------------------
FROM base AS icu-wasm
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG ICU_VERSION
ARG ICU_SHA256
RUN curl -fsSL "https://github.com/unicode-org/icu/releases/download/release-${ICU_VERSION}/icu4c-$(echo ${ICU_VERSION} | tr '-' '_')-src.tgz" \
      -o icu.tgz && echo "${ICU_SHA256}  icu.tgz" | sha256sum -c - \
    && tar xf icu.tgz
# 1. Native host ICU build (only used for its cross-build tools).
RUN mkdir -p icu-host-build && cd icu-host-build \
    && ../icu/source/runConfigureICU Linux --enable-static --disable-shared \
         --disable-tests --disable-samples --disable-extras --disable-tools-tests \
    && make -j"$(nproc)"
# 2. wasm32-emscripten target build against the host build's tools.
RUN mkdir -p icu-wasm-build && cd icu-wasm-build \
    && emconfigure ../icu/source/configure \
         --host=wasm32-unknown-linux --build=x86_64-pc-linux-gnu \
         --with-cross-build=/work/icu-host-build \
         --prefix=/opt/toolchains/icu-wasm \
         --with-data-packaging=archive \
         --enable-static --disable-shared --disable-tests --disable-samples \
         --disable-extras --disable-tools-tests --disable-icuio --disable-layoutex \
         CXXFLAGS="${EM_WASM_EH_FLAGS}" CFLAGS="${EM_WASM_EH_FLAGS}" \
    && emmake make -j"$(nproc)" \
    && emmake make install \
    && rm -rf /work/icu.tgz /work/icu /work/icu-host-build /work/icu-wasm-build
# NOTE (real finding, not an assumption): ICU's genccode has NO wasm32 entry
# in its match-arch object table ("not an ELF object file, or not
# supported"), so --with-data-packaging=static/archive both fail to produce
# a *linkable* libicudata.a on this target -- confirmed by direct build
# error, not inferred. --with-data-packaging=archive instead succeeds and
# installs real converter/locale data as a single flat file:
#   /opt/toolchains/icu-wasm/share/icu/76.1/icudt76l.dat
# libicudata.a here is only the empty ICU stub (harmless to link). The
# kernel must mount icudt76l.dat into the wasm virtual FS (FORCE_FILESYSTEM
# is already on) and call u_setDataDirectory() -- or set env ICU_DATA --
# before any ICU/Xerces call in App::Application::init(). This is a real
# deviation from what upstream's configure-stage1.sh implies (it links
# libicudata.a directly); flagged for E2/kernel-boot integration, not
# silently worked around.

# ----------------------------------------------------------------------------
# xerces-wasm: Xerces-C static, wasm-EH consistent. network=OFF (no sockets
# on wasm); transcoder=icu (emscripten's libc has no usable iconv, and ICU
# is required by FreeCAD's own root CMakeLists regardless -- reuse it).
# ----------------------------------------------------------------------------
FROM icu-wasm AS xerces-wasm
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG XERCES_VERSION
ARG XERCES_SHA256
RUN curl -fsSL "https://archive.apache.org/dist/xerces/c/3/sources/xerces-c-${XERCES_VERSION}.tar.gz" \
      -o xerces.tar.gz && echo "${XERCES_SHA256}  xerces.tar.gz" | sha256sum -c - \
    && tar xf xerces.tar.gz && mv "xerces-c-${XERCES_VERSION}" xerces-src
# xerces-c's own top-level CMakeLists.txt hardcodes `set(CMAKE_CXX_STANDARD 14)`
# (a plain, non-CACHE set() -- a -DCMAKE_CXX_STANDARD=17 on the command line
# cannot override it, it just gets shadowed). ICU 76's headers need C++17
# (std::is_convertible_v etc). Patch the one line rather than fight CMake
# variable scoping.
RUN sed -i 's/set(CMAKE_CXX_STANDARD 14)/set(CMAKE_CXX_STANDARD 17)/' xerces-src/CMakeLists.txt
RUN emcmake cmake -S xerces-src -B xerces-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/toolchains/xerces-wasm \
      -DBUILD_SHARED_LIBS=OFF \
      -Dnetwork=OFF -Dtranscoder=icu -Dmessage-loader=inmemory \
      -Dthreads=OFF \
      -DICU_ROOT=/opt/toolchains/icu-wasm \
      -DCMAKE_FIND_ROOT_PATH=/opt/toolchains/icu-wasm \
      -DCMAKE_CXX_STANDARD=17 -DCMAKE_CXX_STANDARD_REQUIRED=ON \
      -DCMAKE_CXX_FLAGS="${EM_WASM_EH_FLAGS}" \
    && ninja -C xerces-build install \
    && rm -rf xerces.tar.gz xerces-src xerces-build

# ----------------------------------------------------------------------------
# boost-wasm: Boost 1.86.0, compiled components only (program_options, regex,
# date_time -- thread is excluded, matching FreeCAD's own EMSCRIPTEN branch
# in SetupBoost.cmake: "Boost.Thread needs real pthreads; the single-threaded
# wasm build replaces its two mutex uses with std::mutex"). Boost.Build (b2)
# has no built-in Emscripten toolset, so em++ is registered as a `gcc`-family
# toolset variant via a user-config.jam -- the standard technique for
# cross-building Boost to novel gcc-compatible targets.
# ----------------------------------------------------------------------------
FROM base AS boost-wasm
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG BOOST_VERSION
ARG BOOST_SHA256
RUN BV_US=$(echo ${BOOST_VERSION} | tr '.' '_') && \
    curl -fsSL "https://archives.boost.io/release/${BOOST_VERSION}/source/boost_${BV_US}.tar.gz" \
      -o boost.tar.gz && echo "${BOOST_SHA256}  boost.tar.gz" | sha256sum -c - \
    && tar xf boost.tar.gz && mv "boost_${BV_US}" boost-src
RUN cd boost-src && ./bootstrap.sh --with-libraries=program_options,regex,date_time
RUN cat > boost-src/tools/build/src/user-config.jam <<'EOF'
using gcc : emscripten : em++ :
  <archiver>emar
  <ranlib>emranlib
  <cxxflags>-fwasm-exceptions
  <cxxflags>-sWASM_LEGACY_EXCEPTIONS=0
  <compileflags>-fwasm-exceptions
  <compileflags>-sWASM_LEGACY_EXCEPTIONS=0
;
EOF
RUN cd boost-src && ./b2 \
      toolset=gcc-emscripten target-os=linux address-model=32 \
      link=static threading=single variant=release \
      --layout=system --prefix=/opt/toolchains/boost-wasm \
      --with-program_options --with-regex --with-date_time \
      install -j"$(nproc)" \
    && rm -rf /work/boost.tar.gz /work/boost-src
# NOTE: without address-model=32, b2 tags the compiled variant as 64-bit
# (inherited from the gcc-emscripten toolset's host-like defaults, not
# anything wasm32-specific) even though every .o is a real wasm32 object --
# BoostConfig.cmake's own variant validation then rejects it downstream:
# "libboost_program_options.a (64 bit, need 32)". Confirmed by an actual
# FreeCAD configure failing on exactly that message.

# ----------------------------------------------------------------------------
# python-wasm: CPython, static embed (BUILD_DYNAMIC_LINK_PYTHON=OFF in
# FreeCAD's own configure -- everything links into one wasm binary, no
# dlopen'd extension modules). Steps hand-replicate CPython's own official
# emscripten-build pipeline (its orchestrator script needs Python 3.11+ for
# contextlib.chdir; the emsdk base image ships 3.10, so the steps are run
# directly instead of through that script) plus freecad-web's own
# deps/build/assemble-python-prefix.sh, which is the only place the exact
# upstream CPython version (3.14.4, not the deps/README's unversioned
# "3.14") is recorded. NOTE: CPython renamed this tooling's directory
# between patch releases -- it's Tools/wasm/emscripten/ in 3.14.0 but
# Platforms/emscripten/ in 3.14.4 (confirmed by listing both tarballs);
# freecad-web's comment "Run after `Platforms/emscripten build`" is the
# correct 3.14.4 path, not a typo.
# ----------------------------------------------------------------------------
FROM base AS python-wasm
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG PYTHON_VERSION
ARG PYTHON_SHA256
ARG LIBFFI_VERSION
ARG LIBFFI_SHA256
ARG MPDEC_VERSION
ARG MPDEC_SHA256
ENV PYPREFIX=/opt/toolchains/python-wasm-prefix
RUN curl -fsSL "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz" \
      -o python.tgz && echo "${PYTHON_SHA256}  python.tgz" | sha256sum -c - \
    && tar xf python.tgz && mv "Python-${PYTHON_VERSION}" python-src

# 1. Native "build" Python (used by the cross-build to freeze/regen modules,
# and later by FreeCAD's own build-time codegen scripts as
# Python3_EXECUTABLE). Given a real --prefix and `make install`: an
# in-tree, uninstalled CPython build resolves its own stdlib/extension
# modules (pybuilddir.txt, _sysconfigdata) via relative paths from its
# build directory, so relocating just the bare binary elsewhere breaks it
# outright ("Could not find platform dependent libraries <exec_prefix>",
# ModuleNotFoundError even on `math`) -- confirmed by an actual failed
# FreeCAD ninja build before this was installed properly.
RUN mkdir -p native-build && cd native-build \
    && ../python-src/configure --prefix=/opt/toolchains/python-wasm-native --without-ensurepip \
    && make -j"$(nproc)" \
    && make install

# 2. libffi, cross-built for wasm32 (CPython's own recipe: CHOST=wasm32-unknown-linux).
RUN curl -fsSL "https://github.com/libffi/libffi/releases/download/v${LIBFFI_VERSION}/libffi-${LIBFFI_VERSION}.tar.gz" \
      -o libffi.tar.gz && echo "${LIBFFI_SHA256}  libffi.tar.gz" | sha256sum -c - \
    && tar xf libffi.tar.gz
# CFLAGS include EM_WASM_EH_FLAGS: libffi's trampoline/closure code
# generates unwind-relevant code paths across the C/C++ FFI boundary, and
# leaving it on emscripten's default exception model while everything
# else uses -fwasm-exceptions produced a linked FreeCADCmd.wasm that
# neither emscripten's own internal wasm-opt pass nor our own
# --translate-to-exnref could even PARSE ("[parse exception: popping from
# empty stack]" -- a genuinely corrupt module, not just a feature-flag
# mismatch) -- confirmed by bisecting which dependencies were missing our
# EH flags after ruling out the EH-vs-JS-ABI and OCCT-miscompile causes.
RUN cd "libffi-${LIBFFI_VERSION}" \
    && CFLAGS="-O2 -fPIC -DWASM_BIGINT ${EM_WASM_EH_FLAGS}" CXXFLAGS="-O2 -fPIC -DWASM_BIGINT ${EM_WASM_EH_FLAGS}" \
       CPATH="$PYPREFIX/include" PKG_CONFIG_PATH="$PYPREFIX/lib/pkgconfig" \
       EM_PKG_CONFIG_PATH="$PYPREFIX/lib/pkgconfig" \
       emconfigure ./configure --host=wasm32-unknown-linux --prefix="$PYPREFIX" \
         --enable-static --disable-shared --disable-dependency-tracking \
         --disable-builddir --disable-multi-os-directory --disable-raw-api --disable-docs \
    && make install \
    && cp fficonfig.h "$PYPREFIX/include/" \
    && cp include/ffi_common.h "$PYPREFIX/include/"

# 3. mpdecimal, cross-built for wasm32.
RUN curl -fsSL "https://www.bytereef.org/software/mpdecimal/releases/mpdecimal-${MPDEC_VERSION}.tar.gz" \
      -o mpdecimal.tar.gz && echo "${MPDEC_SHA256}  mpdecimal.tar.gz" | sha256sum -c - \
    && tar xf mpdecimal.tar.gz
# --host= added because adding EM_WASM_EH_FLAGS broke mpdecimal's plain
# (non-cross-flagged) `./configure`: without --host, it runs an AC_TRY_RUN
# "can we execute compiled programs" check via emconfigure's node-based
# execution shim, which worked with no EH flags but fails once
# -fwasm-exceptions is added ("cannot run C compiled programs") --
# presumably the resulting probe binary needs newer node/V8 EH support
# than that plain shim invokes with. --host= makes autoconf treat this as
# a real cross-compile and skip execution-based checks entirely, matching
# how libffi's own configure call already avoids the same trap.
RUN cd "mpdecimal-${MPDEC_VERSION}" \
    && emconfigure ./configure --host=wasm32-unknown-linux CFLAGS="-fPIC ${EM_WASM_EH_FLAGS}" --prefix="$PYPREFIX" --disable-shared \
    && make install

# 4. Host (wasm32-emscripten) CPython, static: --without-pymalloc (matches
# upstream), --disable-shared, --without-ensurepip; no
# --enable-wasm-dynamic-linking (that flag makes further extension .so files
# dlopen-loadable at runtime -- freecad-web's own comment confirms the plain
# static archive already has "Modules/expat etc. end up inside libpython for
# the static build", i.e. the flag is additive capability, not required for
# a working static libpython3.14.a; omitted here since FreeCAD's own
# BUILD_DYNAMIC_LINK_PYTHON=OFF wants everything static in one binary).
RUN mkdir -p host-build && cd host-build \
    && CONFIG_SITE=/work/python-src/Platforms/emscripten/config.site-wasm32-emscripten \
       EM_PKG_CONFIG_PATH="$PYPREFIX/lib/pkgconfig" \
       emconfigure ../python-src/configure \
         CFLAGS="-DPY_CALL_TRAMPOLINE -sUSE_BZIP2 ${EM_WASM_EH_FLAGS}" \
         PKG_CONFIG=pkg-config \
         --host=wasm32-emscripten --build=x86_64-pc-linux-gnu \
         --with-build-python=/work/native-build/python \
         --without-pymalloc --without-ensurepip --disable-shared --disable-ipv6 \
         --enable-big-digits=30 \
         --prefix="$PYPREFIX" \
    && make -j"$(nproc)"

# 5. Assemble the clean prefix FreeCAD's configure-stage1.sh expects:
#    include/python3.14/, lib/libpython3.14.a, lib/python3.14/ (stdlib tree).
# The NATIVE 3.14 "build python" is left as its own separate, properly
# `make install`-ed prefix at /opt/toolchains/python-wasm-native (see step
# 1) rather than copied in here -- CMake's FindPython3 COMPONENTS
# "Interpreter Development" (FreeCAD's own SetupPython.cmake macro) runs
# whatever Python3_EXECUTABLE points at to cross-check its version against
# the Development headers/library it is given. Pointing it at the base
# image's system python3.10 fails that check ("Could NOT find Python3 ...
# found version 3.10.12") even with correct Python3_INCLUDE_DIR/
# Python3_LIBRARY, because 3.10 != 3.14; this cross-build's own bootstrap
# "build Python" (otherwise thrown away) reports the matching version.
# libpython3.14.a itself does NOT contain the HACL* hash-module objects --
# md5module.o/sha1module.o/etc call into _Py_LibHacl_Hacl_Hash_* symbols
# that live as loose, unarchived .o files under
# host-build/Modules/_hacl/*.o (confirmed by a debug `find` after an
# actual "undefined symbol: _Py_LibHacl_Hacl_Hash_MD5_malloc" kernel link
# failure). Archive them into libHacl.a here; libexpat.a is likewise a
# separate archive under Modules/expat/, not folded into libpython3.14.a.
RUN OUT=/opt/toolchains/python-wasm && mkdir -p "$OUT/include/python3.14" "$OUT/lib" \
    && cp -r python-src/Include/. "$OUT/include/python3.14/" \
    && cp host-build/pyconfig.h "$OUT/include/python3.14/" \
    && cp host-build/libpython3.14.a "$OUT/lib/" \
    && cp "$PYPREFIX"/lib/*.a "$OUT/lib/" \
    && emar rcs "$OUT/lib/libHacl.a" host-build/Modules/_hacl/*.o \
    && cp host-build/Modules/expat/libexpat.a "$OUT/lib/" \
    && mkdir -p "$OUT/lib/python3.14" \
    && cp -r python-src/Lib/. "$OUT/lib/python3.14/" \
    && find host-build -name '_sysconfigdata*.py' -exec cp {} "$OUT/lib/python3.14/" \; \
    && rm -rf /work/python.tgz /work/python-src /work/native-build /work/host-build \
              /work/libffi.tar.gz "/work/libffi-${LIBFFI_VERSION}" \
              /work/mpdecimal.tar.gz "/work/mpdecimal-${MPDEC_VERSION}"

# ----------------------------------------------------------------------------
# occt-wasm: OCCT (the CAD kernel), headless subset. OCCT already has native
# Emscripten awareness in its own CMakeLists.txt (USE_OPENGL is
# auto-forced OFF for EMSCRIPTEN; USE_VTK/USE_TBB/USE_RAPIDJSON default OFF
# already) -- only Draw (Tcl/Tk test harness) and Visualization (needs
# OpenGL) need to be explicitly turned off for a headless build.
# FoundationClasses, ModelingData, ModelingAlgorithms, ApplicationFramework
# (OCAF -- FreeCAD's own document model builds on this) and DataExchange
# (STEP/IGES/STL) stay on.
# ----------------------------------------------------------------------------
FROM base AS occt-wasm
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG OCCT_VERSION
ARG OCCT_SHA256
# Debug/experiment lever for the ChFi3d_Builder::Compute() miscompile (see
# the ARG block at the top of this file and engine/docs/toolchain.md). The
# defaults below are CMake's own Release defaults, so leaving these unset
# reproduces today's shipped -O3 build byte-for-byte. Override only to
# re-test an optimization-level hypothesis against the CURRENT emsdk/clang
# pin -- do not bake a non-default value in here permanently without
# updating the NOTE further down and re-confirming the perf tradeoff.
ARG OCCT_CXX_FLAGS_RELEASE="-O3 -DNDEBUG"
ARG OCCT_C_FLAGS_RELEASE="-O3 -DNDEBUG"
RUN OV_US=$(echo "${OCCT_VERSION}" | tr '.' '_') && \
    curl -fsSL "https://github.com/Open-Cascade-SAS/OCCT/archive/refs/tags/V${OV_US}.tar.gz" \
      -o occt.tar.gz && echo "${OCCT_SHA256}  occt.tar.gz" | sha256sum -c - \
    && tar xf occt.tar.gz && mv "OCCT-${OV_US}" occt-src
# adm/cmake/occt_toolkit.cmake unconditionally does
# `install(FILES .../${PROJECT_NAME}.wasm ...)` for every EMSCRIPTEN
# executable target with no OPTIONAL. ExpToCasExe (a build-time-only EXPRESS
# schema codegen tool, never used at FreeCAD runtime) links to a
# self-contained .js with no separate sibling .wasm, which turns a harmless
# missing dev-tool artifact into a hard `ninja install` failure -- confirmed
# by an actual failed build, not inferred. We don't need any OCCT
# executables at all (library-only headless kernel), so make the install
# tolerant of a missing .wasm rather than hunting down every toolkit that
# might trip the same install-script assumption.
RUN sed -E -i 's#^(\s*install\(FILES .*\.wasm DESTINATION "[^"]*")\)$#\1 OPTIONAL)#' \
      occt-src/adm/cmake/occt_toolkit.cmake
# NOTE (CORRECTED): see the ARG block at the top of this file for the full,
# corrected diagnosis. Short version: 8 specific OCCT TUs miscompile at -O3
# with new wasm-EH; no optimization level fixes it at any scope; the fix
# is -fignore-exceptions on exactly those 8 files, applied by
# occt-eh-fixups.sh below, AFTER the normal ninja install (so the archives
# it patches already exist) and BEFORE occt-src/occt-build are removed (so
# it still has the source and the generated include tree to recompile
# against). Do not skip this step or the exact same G3 failure recurs.
COPY docker/occt-eh-fixups.sh /usr/local/bin/occt-eh-fixups.sh
RUN emcmake cmake -S occt-src -B occt-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/toolchains/occt-wasm \
      -DBUILD_LIBRARY_TYPE=Static \
      -DBUILD_MODULE_Draw=OFF -DBUILD_MODULE_Visualization=OFF \
      -DUSE_FREETYPE=OFF -DUSE_TK=OFF -DUSE_VTK=OFF -DUSE_TBB=OFF \
      -DUSE_RAPIDJSON=OFF -DUSE_FREEIMAGE=OFF \
      -DBUILD_DOC_Overview=OFF \
      -DCMAKE_CXX_FLAGS="${EM_WASM_EH_FLAGS}" -DCMAKE_C_FLAGS="${EM_WASM_EH_FLAGS}" \
      -DCMAKE_CXX_FLAGS_RELEASE="${OCCT_CXX_FLAGS_RELEASE}" \
      -DCMAKE_C_FLAGS_RELEASE="${OCCT_C_FLAGS_RELEASE}" \
    && ninja -C occt-build install -j"$(nproc)" \
    && OCCT_SRC=/work/occt-src OCCT_BUILD=/work/occt-build \
       OCCT_OUT=/opt/toolchains/occt-wasm EM_WASM_EH_FLAGS="${EM_WASM_EH_FLAGS}" \
       sh /usr/local/bin/occt-eh-fixups.sh \
    && rm -rf /work/occt.tar.gz /work/occt-src /work/occt-build

# ----------------------------------------------------------------------------
# qt-wasm-aqt: PRIMARY path (operator direction, after this stage's
# from-source sibling below already worked): official prebuilt Qt 6.8.3 via
# aqtinstall -- `all_os wasm 6.8.3 wasm_singlethread` for the target,
# `linux desktop 6.8.3 linux_gcc_64` for QT_HOST_PATH (aqt verifies its own
# hashes). Confirmed present after install: libQt6Core/Network/Xml.a (plus
# Concurrent via QtConcurrent headers bundled in Core in 6.8), all real
# WebAssembly objects, and host moc/lrelease under gcc_64/libexec and
# gcc_64/bin respectively.
#
# Known risk, deliberately NOT preempted here: prebuilt Qt is built with
# emscripten's default (legacy) exception handling, not our
# -fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0. The mandatory post-link
# `wasm-opt --translate-to-exnref --emit-exnref --all-features` step (already
# required for OCCT) is what this is FOR -- test at G3/G4 rather than
# fighting it here. If that normalization fails specifically because of Qt's
# objects, fall back to qt-host-wasm/qt-wasm-core below, which already builds
# Qt 6.11.1 from source with our exact EH flags and is kept as a proven,
# working alternative rather than deleted.
# ----------------------------------------------------------------------------
FROM base AS qt-wasm-aqt
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG QT_AQT_VERSION=6.8.3
RUN pip install --no-cache-dir aqtinstall \
    && python3 -m aqt install-qt all_os wasm "${QT_AQT_VERSION}" wasm_singlethread -O /opt/toolchains/qt-wasm-aqt \
    && python3 -m aqt install-qt linux desktop "${QT_AQT_VERSION}" linux_gcc_64 -O /opt/toolchains/qt-wasm-aqt

# ----------------------------------------------------------------------------
# qt-host-wasm: FALLBACK path, already built and verified working (real
# WebAssembly libQt6Core.a etc. before the aqt direction arrived) -- native
# x86_64 Qt6 qtbase, Core/Network/Xml/Concurrent + tools only (-no-gui skips
# Widgets/OpenGL/PrintSupport, which depend on it). This is QT_HOST_PATH --
# Qt6's own cross-compilation model needs a *matching* full host build (not
# distro qt6-base-dev packages: those don't ship the
# Qt6HostInfo/Qt6CoreTools CMake package files -qt-host-path expects) to run
# moc/rcc/tracegen/qlalr/syncqt during the target configure and build.
# Use this pair (qt-host-wasm + qt-wasm-core) only if qt-wasm-aqt's prebuilt
# objects fail to survive wasm-opt --translate-to-exnref at G3/G4.
# ----------------------------------------------------------------------------
FROM base AS qt-host-wasm
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG QT_VERSION
ARG QTBASE_SHA256
RUN curl -fsSL "https://download.qt.io/official_releases/qt/${QT_VERSION%.*}/${QT_VERSION}/submodules/qtbase-everywhere-src-${QT_VERSION}.tar.xz" \
      -o qtbase.tar.xz && echo "${QTBASE_SHA256}  qtbase.tar.xz" | sha256sum -c - \
    && tar xf qtbase.tar.xz && mv "qtbase-everywhere-src-${QT_VERSION}" qtbase-src
RUN mkdir -p qt-host-build && cd qt-host-build \
    && ../qtbase-src/configure -prefix /opt/toolchains/qt-host \
         -release -static \
         -no-gui -no-widgets -no-opengl -no-dbus \
         -nomake examples -nomake tests \
    && cmake --build . --parallel "$(nproc)" \
    && cmake --install . \
    && rm -rf /work/qtbase.tar.xz /work/qtbase-src /work/qt-host-build
# qttools (specifically its LinguistTools module: lrelease/lupdate/lconvert)
# is a SEPARATE Qt repo from qtbase. qtbase bundles a minimal lrelease
# binary for its own internal use, but the Qt6LinguistToolsConfig.cmake
# package descriptor FreeCAD's SetupQt.cmake looks for
# (`find_package(Qt6 COMPONENTS LinguistTools)`, required unconditionally
# on EMSCRIPTEN even with BUILD_GUI=OFF) only exists if qttools itself is
# built and installed against this host Qt.
ARG QTTOOLS_SHA256
RUN curl -fsSL "https://download.qt.io/official_releases/qt/${QT_VERSION%.*}/${QT_VERSION}/submodules/qttools-everywhere-src-${QT_VERSION}.tar.xz" \
      -o qttools.tar.xz && echo "${QTTOOLS_SHA256}  qttools.tar.xz" | sha256sum -c - \
    && tar xf qttools.tar.xz && mv "qttools-everywhere-src-${QT_VERSION}" qttools-src
# NOTE: -DFEATURE_linguist=OFF (tried first) disables the entire
# src/linguist subdirectory, including the lrelease/lupdate/lconvert
# COMMAND-LINE tools, not just the Linguist.app GUI -- confirmed by an
# actual build with no Qt6LinguistTools cmake package produced at all.
# Leave FEATURE_linguist on; only skip the GUI-heavy pieces.
RUN mkdir -p qttools-build && cd qttools-build \
    && /opt/toolchains/qt-host/bin/qt-cmake ../qttools-src \
         -DCMAKE_BUILD_TYPE=Release -DFEATURE_designer=OFF \
         -DFEATURE_assistant=OFF -DFEATURE_pixeltool=OFF \
         -DFEATURE_qtdiag=OFF -DFEATURE_qtplugininfo=OFF \
    && cmake --build . --parallel "$(nproc)" \
    && cmake --install . \
    && rm -rf /work/qttools.tar.xz /work/qttools-src /work/qttools-build

# ----------------------------------------------------------------------------
# qt-wasm-core: the same qtbase source, cross-built for wasm32 via Qt's own
# `-platform wasm-emscripten` mkspec (Qt has first-party Emscripten support;
# this is NOT a generic emcmake/CMAKE_TOOLCHAIN_FILE build like the other
# deps -- Qt's configure invokes em++ itself once emsdk_env.sh is on PATH,
# which the base image already provides).
#
# UPDATED for TechDraw (BUILD_TECHDRAW=ON): originally Core/Network/Xml/
# Concurrent only, matching FreeCAD's FREECAD_QT_COMPONENTS list for
# BUILD_GUI=OFF. TechDraw's own App-layer code (Preferences.cpp,
# LineGenerator.h, Cosmetic.h) uses QApplication/QPen/QColor as plain DATA
# TYPES even with no GUI shown -- confirmed by the actual compile errors,
# not assumed -- so Gui and Widgets are now enabled too. Using qt-wasm-aqt's
# prebuilt Qt 6.8.3 for these instead (it already has Widgets) was rejected:
# it is a DIFFERENT Qt version built by a different toolchain than this
# from-source 6.11.1 tree, and mixing prebuilt-binary Gui/Widgets objects
# with from-source Core/Concurrent objects at link time risks silent ABI
# mismatch -- one consistent from-source build is safer than two combined.
# -no-opengl tried first and REJECTED: Qt's own WebAssembly platform-
# integration plugin (QWasmIntegrationPlugin, src/plugins/platforms/wasm) is
# not merely OpenGL-accelerated -- it structurally requires it
# (qwasmopenglcontext.h subclasses QPlatformOpenGLContext unconditionally),
# so -no-opengl fails to compile the plugin outright ("base class has
# incomplete type", confirmed by an actual build, not assumed). Switched to
# -opengl es2 (WebGL ES2 via Emscripten), the same configuration the
# prebuilt qt-wasm-aqt package already ships and the standard, well-trodden
# Qt-for-WebAssembly setup -- not novel territory the way the wasm-EH flags
# below are. Never actually exercised at runtime unless FreeCAD's own code
# creates a visible window, which BUILD_GUI=OFF at the FreeCAD level (a
# separate switch from this Qt-level one) does not do.
# ----------------------------------------------------------------------------
FROM qt-host-wasm AS qt-wasm-core
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG QT_VERSION
ARG QTBASE_SHA256
RUN curl -fsSL "https://download.qt.io/official_releases/qt/${QT_VERSION%.*}/${QT_VERSION}/submodules/qtbase-everywhere-src-${QT_VERSION}.tar.xz" \
      -o qtbase.tar.xz && echo "${QTBASE_SHA256}  qtbase.tar.xz" | sha256sum -c - \
    && tar xf qtbase.tar.xz && mv "qtbase-everywhere-src-${QT_VERSION}" qtbase-src
# CORRECTED, superseding an earlier wrong conclusion (see git history):
# forcing -fwasm-exceptions alone onto Qt's build failed --
# "invalid argument '-fwasm-exceptions' not allowed with
# '-enable-emscripten-sjlj'" on bundled PCRE2 -- and the fix I shipped then
# was to leave Qt on its legacy JS-exception ABI entirely and hope
# wasm-opt --translate-to-exnref would reconcile it at kernel link time.
# That was wrong: --translate-to-exnref only rewrites wasm-EH bytecode
# encodings (legacy wasm-EH opcodes -> exnref); the JS-exception model
# has NO wasm-EH opcodes at all, it calls JS-implemented runtime helpers
# (__resumeException, llvm_eh_typeid_for) that plain don't exist when the
# rest of the link is built for the wasm-EH ABI -- confirmed by an actual
# kernel link failing with exactly those "undefined symbol" errors on
# Qt's own libQt6Core.a objects (qlogging.cpp.o, qdebug.cpp.o, ...).
# The real fix, found by reading FreeCAD's OWN current
# src/Main/CMakeLists.txt link-flags block (which upstream already
# compiles "the whole module ... with -fwasm-exceptions
# -sWASM_LEGACY_EXCEPTIONS=0", Qt included): emcc auto-selects the legacy
# JS-based setjmp/longjmp lowering (which is what actually forces
# -enable-emscripten-sjlj, and that in turn conflicts with
# -fwasm-exceptions) UNLESS -sSUPPORT_LONGJMP=wasm is also given, per that
# same CMakeLists.txt's own comment: "wasm-EH forbids the legacy
# emscripten (JS) longjmp, and OCCT + freetype reference __wasm_longjmp".
# Passing -sSUPPORT_LONGJMP=wasm alongside our EH flags resolves the
# PCRE2 conflict and lets Qt build genuinely wasm-EH objects like
# everything else.
RUN mkdir -p qt-wasm-build && cd qt-wasm-build \
    && ../qtbase-src/configure -prefix /opt/toolchains/qt-wasm \
         -platform wasm-emscripten -qt-host-path /opt/toolchains/qt-host \
         -release -static \
         -gui -widgets -opengl es2 -no-dbus \
         -nomake examples -nomake tests \
         -- -DCMAKE_CXX_FLAGS="${EM_WASM_EH_FLAGS} -sSUPPORT_LONGJMP=wasm" \
            -DCMAKE_C_FLAGS="${EM_WASM_EH_FLAGS} -sSUPPORT_LONGJMP=wasm" \
    && cmake --build . --parallel "$(nproc)" \
    && cmake --install . \
    && rm -rf /work/qtbase.tar.xz /work/qtbase-src /work/qt-wasm-build

# ----------------------------------------------------------------------------
# toolchain: final consolidated image -- every dependency prefix copied into
# one /opt/toolchains tree, matching the layout configure-stage1.sh expects
# ($TC/occt-wasm, $TC/xerces-wasm, $TC/fmt-wasm, $TC/yaml-wasm,
# $TC/python-wasm, $TC/boost-wasm, $TC/icu-wasm, $TC/qt-host). This is the
# image Dockerfile.kernel builds FROM. Qt6_DIR points at qt-wasm-aqt (the
# primary path); switch to qt-wasm-core (the from-source fallback) only if
# G3/G4 finds the prebuilt Qt's legacy EH does not survive
# wasm-opt --translate-to-exnref.
# ----------------------------------------------------------------------------
FROM base AS toolchain
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY --from=fmt-wasm      /opt/toolchains/fmt-wasm      /opt/toolchains/fmt-wasm
COPY --from=yamlcpp-wasm  /opt/toolchains/yaml-wasm      /opt/toolchains/yaml-wasm
COPY --from=icu-wasm      /opt/toolchains/icu-wasm       /opt/toolchains/icu-wasm
COPY --from=xerces-wasm   /opt/toolchains/xerces-wasm    /opt/toolchains/xerces-wasm
COPY --from=boost-wasm    /opt/toolchains/boost-wasm     /opt/toolchains/boost-wasm
COPY --from=python-wasm   /opt/toolchains/python-wasm    /opt/toolchains/python-wasm
COPY --from=python-wasm   /opt/toolchains/python-wasm-native /opt/toolchains/python-wasm-native
COPY --from=occt-wasm     /opt/toolchains/occt-wasm      /opt/toolchains/occt-wasm
COPY --from=qt-wasm-aqt   /opt/toolchains/qt-wasm-aqt    /opt/toolchains/qt-wasm-aqt
# qt-host-wasm/qt-wasm-core (from-source fallback) ALSO copied in: aqt's
# wasm_singlethread package has NO Qt6Concurrent at all (confirmed by
# listing lib/cmake/ -- dozens of GUI/Quick modules present, Concurrent
# absent), and FreeCAD's SetupQt.cmake hard-requires Qt6::Concurrent even
# headless. This is a real gap found at G2 configure time, not a G3/G4 EH
# risk -- the from-source build is the one actually used for the kernel.
COPY --from=qt-host-wasm  /opt/toolchains/qt-host        /opt/toolchains/qt-host
COPY --from=qt-wasm-core  /opt/toolchains/qt-wasm        /opt/toolchains/qt-wasm
