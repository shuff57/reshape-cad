      "group": "Structure",
      "label": "Create a Shape Binder",
      "reshape": null,
      "status": "refused",
      "reason": "ShapeBinder is multi-body plumbing: it imports a shape from another body/project. A single-body student tool has no second body to bind from."
    },
    {
      "id": "PartDesign_SubShapeBinder",
      "group": "Structure",
      "label": "Create a Sub-Object(s) Shape Binder",
      "reshape": null,
      "status": "refused",
      "reason": "SubShapeBinder is multi-body plumbing: it links part of another body or an external project into this one. A single-body student tool does not need cross-body links."
    },
