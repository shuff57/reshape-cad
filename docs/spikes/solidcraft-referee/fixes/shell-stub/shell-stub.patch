+/// The shell's own failures in words a user can act on: the cutting step's and the offset's
+/// internal wording is replaced, the cause is kept where it is known.
+fn plain_shell_error(e: KernelError) -> KernelError {
+    let KernelError::Failed(m) = &e else { return e };
+    if m.contains("boolean ") || m.contains("exact fallback") || m.contains("implausible result") {
+        return unsupported_shell(
+            "the kernel cannot build this shell yet: its inner wall meets the part's own faces in a way it cannot cut (a feature close to the opening or to a wall); another shell thickness, or opening another face, may work",
+        );
+    }
+    // Only the offset's size limits (a rim, ledge or wall thinner than the move) are reworded;
+    // its corner message is left as it is.
+    let plain =
+        if m.starts_with("offset: not supported yet") { m.replace("the operation failed: ", "").replacen("offset: ", "", 1) } else { m.clone() };
+    if plain == *m { e } else { KernelError::Failed(plain) }
