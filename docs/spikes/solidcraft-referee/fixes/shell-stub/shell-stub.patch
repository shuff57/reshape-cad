+/// Whether shelling `before` into `after` split a piece in two: some piece of `before`
+/// has more than one piece of `after` inside its bounding box.
+fn comes_apart(before: &Body, after: &Body) -> Result<bool> {
+    let boxes = |b: &Body| -> Result<Vec<(Vec3, Vec3)>> { b.lumps()?.iter().map(|l| crate::measure(l).map(|m| (m.bbox.min, m.bbox.max))).collect() };
+    let tol = (before.size() * 1e-6).max(1e-9);
+    let (was, now) = (boxes(before)?, boxes(after)?);
+    let inside = |o: &(Vec3, Vec3), i: &(Vec3, Vec3)| {
+        o.0.x >= i.0.x - tol && o.0.y >= i.0.y - tol && o.0.z >= i.0.z - tol && o.1.x <= i.1.x + tol && o.1.y <= i.1.y + tol && o.1.z <= i.1.z + tol
+    };
+    Ok(was.iter().any(|w| now.iter().filter(|n| inside(n, w)).count() > 1) || now.len() > was.len())
+}
+
+/// The faces of `b` other than the `opened` ones that stand on an opened planar face, and how far
+/// they reach beyond its plane: a face stands on it when it meets the open face along an edge that
+/// is concave (the face's outward normal there points back over the open face), as a boss wall, a
+/// pocket's wall or a notch's floor do. A face that only runs along the plane or lies on the
+/// body's side of it, and material elsewhere (another piece, a far step), does not.
+fn faces_standing_on(b: &Body, mesh: &solidcraft_geom::Mesh, opened: &[usize]) -> (Vec<usize>, f64) {
+    use mt::{BoundedCurve, ParametricCurve};
+    let size = b.size();
+    let tol = (size * 1e-6).max(1e-9);
+    let faces: Vec<mt::Face> = b.solid.face_iter().cloned().collect();
+    let planes: Vec<(usize, Vec3, f64)> = opened
+        .iter()
+        .filter_map(|i| match crate::offset::surf_of(faces.get(*i)?, tol * 100.0) {
+            Some(crate::offset::Surf::Plane { n, d }) => Some((*i, n, d)),
+            _ => None,
+        })
+        .collect();
+    let mut by_edge: HashMap<mt::EdgeID, Vec<usize>> = HashMap::new();
+    for (i, f) in faces.iter().enumerate() {
+        for e in f.edge_iter() {
+            let v = by_edge.entry(e.id()).or_default();
+            if !v.contains(&i) {
+                v.push(i);
+            }
+        }
+    }
+    // Whether `p` (on the plane with normal `n`) lies in the triangle.
+    let in_tri = |p: Vec3, t: &[Vec3; 3], n: Vec3| {
+        let side = |a: Vec3, c: Vec3| (c - a).cross(p - a).dot(n);
+        let s = [side(t[0], t[1]), side(t[1], t[2]), side(t[2], t[0])];
+        s.iter().all(|x| *x >= -1e-12) || s.iter().all(|x| *x <= 1e-12)
+    };
+    let mut out: Vec<usize> = Vec::new();
+    for (gi, n, _) in &planes {
+        let Some(g) = faces.get(*gi) else { continue };
+        let gtris: Vec<[Vec3; 3]> =
+            mesh.triangles.iter().zip(&mesh.tri_face).filter(|(_, f)| **f as usize == *gi).filter_map(|(t, _)| mesh.tri(t)).collect();
+        for e in g.edge_iter() {
+            let c = e.curve();
+            let (t0, t1) = c.range_tuple();
+            let at = |k: f64| from_p3(c.subs(t0 + (t1 - t0) * k));
+            let m = at(0.5);
+            let (Some(tg), true) = ((at(0.55) - at(0.45)).normalized(), t1 > t0) else { continue };
+            let Some(w) = n.cross(tg).normalized() else { continue };
+            let delta = size * 1e-4;
+            let inward = if gtris.iter().any(|t| in_tri(m + w * delta, t, *n)) {
+                w
+            } else if gtris.iter().any(|t| in_tri(m - w * delta, t, *n)) {
+                -w
+            } else {
+                continue;
+            };
+            let across = -inward;
+            for fi in by_edge.get(&e.id()).into_iter().flatten() {
+                if opened.contains(fi) || out.contains(fi) {
+                    continue;
+                }
+                let Some(f) = faces.get(*fi) else { continue };
+                // An outward normal pointing back over the open face: the edge is concave. A face
+                // whose surface is not known counts as standing (the caller then refuses).
+                match crate::offset::surf_of(f, tol * 100.0).and_then(|s| s.normal(m)) {
+                    Some(nf) if nf.dot(across) >= -1e-3 => {}
+                    _ => out.push(*fi),
+                }
+            }
+        }
+    }
+    let mut height = 0.0f64;
+    for (t, f) in mesh.triangles.iter().zip(&mesh.tri_face) {
+        if !out.contains(&(*f as usize)) {
+            continue;
+        }
+        if let Some(tri) = mesh.tri(t) {
+            height = tri.iter().flat_map(|p| planes.iter().map(move |(_, n, d)| n.dot(*p) - d)).fold(height, f64::max);
+        }
+    }
+    (out, height)
+}
