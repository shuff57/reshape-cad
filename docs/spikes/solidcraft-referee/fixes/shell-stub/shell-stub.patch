+/// Shell of a body with a boss standing on the face that is opened. Every face moves in along
+/// its plane, so the boss's wall must run the whole way down to the opened face's plane (it
+/// once started at that plane plus the shell's internal margin, 8.657 for a plane at 5).
+/// A boss standing clear of the part's wall would be left floating: refused, not built wrong.
+#[test]
+fn shell_open_face_with_a_boss_on_it() {
+    let plane = 2776.0; // 12800 outer, less 38x28x9 and 8x8x7 cavities
+    // Boss against the base's +x wall (x 10..20): one piece, the exact plane-offset volume.
+    let flush = stub_shell(Vec3::new(10.0, 10.0, 8.0), Vec3::new(15.0, 0.0, 9.0), 1.0).unwrap();
+    let v = measure(&flush).unwrap().volume;
+    assert!(rel(v, plane) < 1e-3, "{v} vs {plane}");
+    assert_eq!(flush.lumps().unwrap().len(), 1);
+    let corner = stub_shell(Vec3::new(10.0, 10.0, 8.0), Vec3::new(15.0, 10.0, 9.0), 1.0).unwrap();
+    let v = measure(&corner).unwrap().volume;
