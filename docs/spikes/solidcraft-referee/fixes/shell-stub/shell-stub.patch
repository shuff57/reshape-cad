+fn too_thin(at: Vec3, short: f64, thickness: f64) -> KernelError {
+    unsupported_shell(&format!(
+        "a floor, wall or ligament near [{:.2}, {:.2}, {:.2}] is too thin for a {thickness:.4} mm shell: the walls on its two sides would overlap by about {short:.3} mm (material between two faces needs more than twice the shell thickness, {:.4} mm)",
+        at.x,
+        at.y,
+        at.z,
+        2.0 * thickness
+    ))
+}
+
+/// Where a face of the shell's `cavity` comes closer than `t` to a face of `part` (not an opened
+/// one), and by how much it falls short: the offsets of two faces of a thin web have crossed
+/// there. The face a cavity face was moved from is exactly `t` away, so it never counts. Sampled
+/// on the cavity's mesh and measured square to the part's faces (a foot inside the triangle), as
+/// the edges of the part's faces next to the open face are not walls in front of the cavity; a
+/// curved face on either side is given the room its meshing can be out by. `None` when meshing
+/// fails (the shell is then left as it was).
+fn cavity_too_close(part: &Body, cavity: &Body, opened: &[usize], t: f64, margin: f64) -> Option<(Vec3, f64)> {
+    use crate::offset::{Surf, surf_of};
+    // A round thinner than the shell collapses in the offset and its faces are dropped: the
+    // cavity then has pinched lines and corners that are not walls. Left to the old path.
+    if cavity.face_count() != part.face_count() {
+        return None;
+    }
+    let size = part.size();
+    let sag = (size * 2e-4).max(1e-4);
+    let pm = part.tessellate_with(sag, true).ok()?;
+    let cm = cavity.tessellate_with(sag, true).unwrap_or_default();
+    let faces: Vec<mt::Face> = part.solid.face_iter().cloned().collect();
+    let is_plane = |f: &mt::Face| matches!(surf_of(f, size * 1e-5), Some(Surf::Plane { .. }));
+    let planar: Vec<bool> = faces.iter().map(is_plane).collect();
+    let cplanar: Vec<bool> = cavity.solid.face_iter().map(is_plane).collect();
+    // The cavity's faces that stand where the open faces were (moved out by `margin`): the
+    // opening itself, not walls.
+    let open_planes: Vec<(Vec3, f64)> = opened
+        .iter()
+        .filter_map(|i| match surf_of(faces.get(*i)?, size * 1e-5) {
+            Some(Surf::Plane { n, d }) => Some((n, d + margin)),
+            _ => None,
+        })
+        .collect();
+    let is_opening: Vec<bool> = cavity
+        .solid
+        .face_iter()
+        .map(|f| match surf_of(f, size * 1e-5) {
+            Some(Surf::Plane { n, d }) => open_planes.iter().any(|(n2, d2)| n.dot(*n2) > 1.0 - 1e-9 && (d - d2).abs() < size * 1e-6),
+            _ => false,
+        })
+        .collect();
+    let tris: Vec<(usize, [Vec3; 3])> = pm
+        .triangles
+        .iter()
+        .zip(&pm.tri_face)
+        .filter(|(_, f)| !opened.contains(&(**f as usize)))
+        .filter_map(|(tr, f)| pm.tri(tr).map(|v| (*f as usize, v)))
+        .collect();
+    // The distance from `p` to a triangle's plane, when the foot lies inside the triangle.
+    // The open face extruded out by `t` is part of the space the cut sees as solid, so what
+    // stands on the open face is no wall until `t` above it: feet that low are not counted.
+    let ext_planes: Vec<(Vec3, f64)> = opened
+        .iter()
+        .filter_map(|i| match surf_of(faces.get(*i)?, size * 1e-5) {
+            Some(Surf::Plane { n, d }) => Some((n, d)),
+            _ => None,
+        })
+        .collect();
+    let square = |p: Vec3, v: &[Vec3; 3]| -> Option<f64> {
+        let n = (v[1] - v[0]).cross(v[2] - v[0]);
+        let nn = n.normalized()?;
+        let q = p - nn * (p - v[0]).dot(nn);
+        let inside = [(v[0], v[1]), (v[1], v[2]), (v[2], v[0])].iter().all(|(a, b)| (*b - *a).cross(q - *a).dot(n) >= -1e-12 * n.len());
+        if ext_planes.iter().any(|(on, od)| {
+            let h = on.dot(q) - od;
+            h > -size * 1e-6 && h < t
+        }) {
+            return None;
+        }
+        inside.then(|| (p - v[0]).dot(nn).abs())
+    };
+    let cavity_surfs: Vec<Option<Surf>> = cavity.solid.face_iter().map(|f| surf_of(f, size * 1e-5)).collect();
+    // Bounded work: a grid of samples per triangle, thinned when the product is large.
+    let mut samples: Vec<(usize, Vec3)> = Vec::new();
+    for (tr, f) in cm.triangles.iter().zip(&cm.tri_face) {
+        if is_opening.get(*f as usize).copied().unwrap_or(false) {
+            continue;
+        }
+        if let Some([a, b, c]) = cm.tri(tr) {
+            // A grid over the triangle of a flat face; of a curved face only its corners (a long
+            // triangle there reaches past the trimmed edge of the face).
+            let n: usize = if cplanar.get(*f as usize).copied().unwrap_or(false) { 4 } else { 1 };
+            for i in 0..=n {
+                for j in 0..=(n - i) {
+                    let mut q = a + (b - a) * (i as f64 / n as f64) + (c - a) * (j as f64 / n as f64);
+                    // Onto the face's own surface: a long triangle of a curved face cuts through it.
+                    if let Some(Some(sf)) = cavity_surfs.get(*f as usize)
+                        && let Some(g) = sf.grad(q)
+                    {
+                        q = q - g * sf.dist(q);
+                    }
+                    samples.push((*f as usize, q));
+                }
+            }
+        }
+    }
+    // The cavity's corners and edges as well (they need no meshing of the cavity's faces).
+    {
+        use mt::{BoundedCurve, ParametricCurve};
+        for v in cavity.solid.vertex_iter() {
+            samples.push((usize::MAX, from_p3(v.point())));
+        }
+        for e in cavity.solid.edge_iter() {
+            let c = e.curve();
+            let (t0, t1) = c.range_tuple();
+            for k in 1..8 {
+                samples.push((usize::MAX, from_p3(c.subs(t0 + (t1 - t0) * k as f64 / 8.0))));
+            }
+        }
+    }
+    // Cavity above an open plane is outside the part (the opening's margin): not material.
+    samples.retain(|(_, p)| !ext_planes.iter().any(|(on, od)| on.dot(*p) - od > size * 1e-6));
+    let stride = (samples.len() * tris.len()).div_ceil(40_000_000).max(1);
+    let mut worst: Option<(Vec3, f64)> = None;
+    for (f, p) in samples.iter().step_by(stride) {
+        for (j, v) in &tris {
+            let Some(d) = square(*p, v) else { continue };
+            let curved = !(cplanar.get(*f).copied().unwrap_or(false) && planar.get(*j).copied().unwrap_or(false));
+            let room = if curved { size * 1e-3 } else { size * 1e-6 };
+            let short = t - room - d;
+            // Edges where curved faces meet are rebuilt through their moved points and lie a
+            // little off (measured 5% of the thickness on a hole through a round wall): a curved
+            // face must fall short by a tenth of the thickness to count.
+            let least = if curved { t * 0.1 } else { (size * 1e-5).max(t * 2e-3) };
+            if short > least && worst.is_none_or(|(_, w)| short > w) {
+                worst = Some((*p, short));
+            }
+        }
+    }
+    worst
+}
+
 /// A shell made from the cavity with every face moved in by the thickness (open faces too),
 /// joined with each open face's moved copy swept out through the body. No history: the
 /// opening's walls, swept from the cavity's edges, come from nothing of `b`.
 fn shell_by_opening(b: &Body, opened: &[usize], thickness: f64, reach: f64) -> Result<Body> {
+    // Closed up that way the cone of a countersink stops at the moved open plane instead of running
+    // on to the opening, so the cut is not the cone's offset there (measured -2.7% .. -3.9%): a
+    // countersink cone (hollow, material outside it) that reaches the open face is not built this
+    // way; a convex cone (a chamfer on a turned part) was not measured wrong and is left alone.
+    let cone_blocked;
+    {
+        let tol = (b.size() * 1e-7).max(1e-9) * 100.0;
+        let faces: Vec<mt::Face> = b.solid.face_iter().cloned().collect();
+        let open_edges: Vec<mt::EdgeID> =
+            opened.iter().filter_map(|i| faces.get(*i)).flat_map(|f| f.edge_iter().map(|e| e.id()).collect::<Vec<_>>()).collect();
+        let cone_at_opening = faces.iter().enumerate().any(|(i, f)| {
+            !opened.contains(&i)
+                && matches!(crate::offset::surf_of(f, tol), Some(crate::offset::Surf::Cone { convex: false, .. }))
+                && f.edge_iter().any(|e| open_edges.contains(&e.id()))
+        });
+        cone_blocked = cone_at_opening;
+    }
     let closed = offset_planar(b, |_, _| -thickness)?;
+    // Both refusals below only replace a shell this way round would have built; where it fails
+    // by itself its own message stands.
+    let thin = cavity_too_close(b, &closed, opened, thickness, -thickness);
     let faces: Vec<mt::Face> = closed.solid.face_iter().cloned().collect();
     let mut cavity = closed.clone();
     for fi in opened {
@@ -624,6 +1125,14 @@ fn shell_by_opening(b: &Body, opened: &[usize], thickness: f64, reach: f64) -> R
         cavity = crate::ops::boolean(&cavity, &prism, crate::BoolOp::Union)?.ok_or_else(|| KernelError::Failed("shell: opening".into()))?;
     }
     let r = crate::ops::boolean(b, &cavity, crate::BoolOp::Cut)?.ok_or_else(|| KernelError::Failed("the shell removed everything".into()))?;
+    if cone_blocked {
+        return Err(unsupported_shell(
+            "the kernel cannot build a shell of this part yet: a cone (a countersink) reaches the opening and a wall is close to it",
+        ));
+    }
+    if let Some((at, short)) = thin {
+        return Err(too_thin(at, short, thickness));
+    }
     Ok(r.without_history())
 }
 
