+/// Bodies where material stands on the opened face and the exact plane-offset path does not
+/// apply (a round face beside it, a torus, a pad lower than the shell is thick): the shell says
+/// so instead of returning a part with the boss cut short (these gave -1.7% to -5.5% before).
+/// Case scripts are lists of solid commands; the shell is the last one.
+fn shell_script(cmds: &str) -> (Session, Result<serde_json::Value, String>) {
+    let steps: Value = serde_json::from_str(cmds).unwrap_or_default();
+    let list = steps.as_array().cloned().unwrap_or_default();
+    let mut s = Session::default();
+    let mut last = Ok(json!(null));
+    for st in &list {
+        let (c, p) = (st["command"].as_str().unwrap_or(""), &st["params"]);
+        last = s.execute(c, p).map_err(|e| e.to_string());
+        if c != "solid.shell" {
+            assert!(last.is_ok(), "{c}: {last:?}");
+        }
+    }
+    (s, last)
+}
