+/// A 40x30x10 base with a boss standing on its top face, shelled open at the base's top.
+fn stub_shell(size: Vec3, centre: Vec3, t: f64) -> Result<Body> {
+    let base = box_solid(Vec3::new(-20.0, -15.0, -5.0), Vec3::new(20.0, 15.0, 5.0)).unwrap();
+    let c = Vec3::new(centre.x - size.x / 2.0, centre.y - size.y / 2.0, centre.z - size.z / 2.0);
+    let stub = box_solid(c, c + size).unwrap();
+    let u = boolean(&base, &stub, BoolOp::Union).unwrap().unwrap();
+    shell(&u, &[Vec3::new(-17.0, -12.0, 5.0)], t)
+}
+
+/// Shell of a body with a boss standing on the face that is opened. Every face moves in along
+/// its plane, so the boss's wall must run the whole way down to the opened face's plane (it
+/// once started at that plane plus the shell's internal margin, 8.657 for a plane at 5).
+/// A boss standing clear of the part's wall would be left floating: refused, not built wrong.
+#[test]
+fn shell_open_face_with_a_boss_on_it() {
+    let plane = 2776.0; // 12800 outer, less 38x28x9 and 8x8x7 cavities
+    // Boss against the base's +x wall (x 10..20): one piece, the exact plane-offset volume.
+    let flush = stub_shell(Vec3::new(10.0, 10.0, 8.0), Vec3::new(15.0, 0.0, 9.0), 1.0).unwrap();
+    let v = measure(&flush).unwrap().volume;
+    assert!(rel(v, plane) < 1e-3, "{v} vs {plane}");
+    assert_eq!(flush.lumps().unwrap().len(), 1);
+    let corner = stub_shell(Vec3::new(10.0, 10.0, 8.0), Vec3::new(15.0, 10.0, 9.0), 1.0).unwrap();
+    let v = measure(&corner).unwrap().volume;
+    assert!(rel(v, plane) < 1e-3, "{v} vs {plane}");
+    // Boss clear of every wall: its tube would rest on nothing.
+    for (size, centre) in [([10.0, 10.0, 8.0], [0.0, 0.0, 9.0]), ([10.0, 10.0, 8.0], [10.0, 0.0, 9.0]), ([12.0, 12.0, 2.0], [5.0, -5.0, 6.0])] {
+        let e = stub_shell(Vec3::new(size[0], size[1], size[2]), Vec3::new(centre[0], centre[1], centre[2]), 1.0).unwrap_err().to_string();
+        assert!(e.contains("free of the rest of the part"), "{e}");
+    }
+}
+
+/// The same shell without a boss is unchanged: outer volume less the plain cavity.
+#[test]
+fn shell_open_top_of_a_plain_body_is_unchanged() {
+    let base = box_solid(Vec3::new(-20.0, -15.0, -5.0), Vec3::new(20.0, 15.0, 5.0)).unwrap();
+    let s = shell(&base, &[Vec3::new(0.0, 0.0, 5.0)], 1.0).unwrap();
+    let v = measure(&s).unwrap().volume;
+    assert!(rel(v, 12000.0 - 38.0 * 28.0 * 9.0) < 1e-9, "{v}");
+}
