+/// A 10x10 rim, 6 mm tall and `w` thick, flush in a corner of a 40x30x10 plate, shelled 1 mm from
+/// the plate's top.
+fn rim_shell(w: f64) -> Result<Body> {
+    let base = box_solid(Vec3::new(-20.0, -15.0, -5.0), Vec3::new(20.0, 15.0, 5.0)).unwrap();
+    let outer = box_solid(Vec3::new(10.0, 5.0, 5.0), Vec3::new(20.0, 15.0, 11.0)).unwrap();
+    let hole = box_solid(Vec3::new(10.0 + w, 5.0 + w, 4.0), Vec3::new(20.0 - w, 15.0 - w, 12.0)).unwrap();
+    let ring = boolean(&outer, &hole, BoolOp::Cut).unwrap().unwrap();
+    let u = boolean(&base, &ring, BoolOp::Union).unwrap().unwrap();
+    shell(&u, &[Vec3::new(-17.0, -12.0, 5.0)], 1.0)
+}
+
+/// A rim thicker than twice the shell is the exact plane offset (2872 - 48 (w - 2)); at twice the
+/// shell (a wall of no thickness in the cavity) or less its two sides cross, and it is refused
+/// instead of built with the artefact that gave 2839.4 for a 1.5 mm rim (exact path: 2802.25).
+#[test]
+fn shell_open_face_with_a_rim_thinner_than_two_walls_is_refused() {
+    for w in [3.0, 2.5, 2.2, 2.05] {
+        let v = measure(&rim_shell(w).unwrap()).unwrap().volume;
+        let want = 2872.0 - 48.0 * (w - 2.0);
+        assert!(rel(v, want) < 1e-6, "w {w}: {v} vs {want}");
+    }
+    for w in [2.0, 1.95, 1.8, 1.5] {
+        let e = rim_shell(w).unwrap_err().to_string();
+        assert!(e.contains("its two sides would cross"), "w {w}: {e}");
+    }
+}
