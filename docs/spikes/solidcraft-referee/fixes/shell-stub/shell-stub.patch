+/// Robustness seed 73: a D-shaped block, a fillet, a box joined on the round wall, then a shell
+/// opened at the box's underside. With the open face left on its plane the shell built, and
+/// measuring the result recursed in the tessellator without end (66 GB). A body with curved
+/// faces keeps the old refusal; the run must end in seconds with the shell refused.
+#[test]
+fn shell_open_underside_on_a_round_wall_ends() {
+    let mut s = Session::default();
+    let steps = [
+        ("sketch.create", json!({"plane": "XY"})),
+        ("sketch.line", json!({"points": [[0, 0], [45.0, 0], [45.0, 25.0], [0, 25.0]]})),
+        ("sketch.arc.three_point", json!({"end": [0, 0], "start": [0, 25.0], "through": [-10.0, 12.5]})),
+        ("sketch.finish", json!({})),
+        ("solid.extrude", json!({"distance": 27.5})),
+        ("solid.fillet", json!({"edges": [[-9.999999999999998, 12.5, 0.0], [45.0, 0.0, 13.75]], "radius": 3.0})),
+        ("solid.box", json!({"corner": [-10.0, 0.0, 12.5], "height": 12.5, "length": 10.0, "operation": "join", "width": 15.0})),
+    ];
+    for (c, p) in &steps {
+        let _ = s.execute(c, p);
+    }
+    let t = std::time::Instant::now();
+    let r = s.execute("solid.shell", &json!({"faces": [[-9.917910263100657, 14.166666666666636, 12.500000000009761]], "thickness": 1.5}));
+    let measured: Vec<f64> = s.model.state().bodies.iter().filter_map(|b| solidcraft_kernel::measure(&b.body).ok()).map(|m| m.volume).collect();
+    assert!(t.elapsed().as_secs() < 60, "took {:?}", t.elapsed());
+    assert!(r.is_err(), "the shell was expected to be refused: {measured:?}");
+}
