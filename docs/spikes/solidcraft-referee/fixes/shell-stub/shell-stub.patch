+/// The thickness of a standing wall thinner than twice `t` (or exactly that): the standing face
+/// and a face looking the other way behind it, a plane parallel to it that overlaps it, or a
+/// cylinder coaxial inside it.
+fn thin_standing_wall(b: &Body, mesh: &solidcraft_geom::Mesh, standing: &[usize], t: f64) -> Option<f64> {
+    use crate::offset::{Surf, surf_of};
+    let tol = (b.size() * 1e-6).max(1e-9);
+    let faces: Vec<mt::Face> = b.solid.face_iter().cloned().collect();
+    let surfs: Vec<Option<Surf>> = faces.iter().map(|f| surf_of(f, tol * 100.0)).collect();
+    // Extent of each face in the plane square to `n`.
+    let extent = |face: usize, u: Vec3, w: Vec3| -> Option<[f64; 4]> {
+        let mut e = [f64::INFINITY, f64::NEG_INFINITY, f64::INFINITY, f64::NEG_INFINITY];
+        for (tri, f) in mesh.triangles.iter().zip(&mesh.tri_face) {
+            if *f as usize != face {
+                continue;
+            }
+            for p in mesh.tri(tri)? {
+                e = [e[0].min(p.dot(u)), e[1].max(p.dot(u)), e[2].min(p.dot(w)), e[3].max(p.dot(w))];
+            }
+        }
+        e[0].is_finite().then_some(e)
+    };
+    let limit = 2.0 * t + tol * 100.0;
+    for &si in standing {
+        let Some(sf) = surfs.get(si).copied().flatten() else { continue };
+        match sf {
+            Surf::Plane { n, d } => {
+                let (u, w) = (n.any_perp(), n.cross(n.any_perp()));
+                let Some(es) = extent(si, u, w) else { continue };
+                for (oi, o) in surfs.iter().enumerate() {
+                    let Some(Surf::Plane { n: n2, d: d2 }) = *o else { continue };
+                    let wall = d + d2;
+                    if oi == si || n2.dot(n) > -1.0 + 1e-9 || wall <= tol * 100.0 || wall > limit {
+                        continue;
+                    }
+                    let Some(eo) = extent(oi, u, w) else { continue };
+                    let overlap = |a: (f64, f64), c: (f64, f64)| a.1.min(c.1) - a.0.max(c.0) > tol * 100.0;
+                    if overlap((es[0], es[1]), (eo[0], eo[1])) && overlap((es[2], es[3]), (eo[2], eo[3])) {
+                        return Some(wall);
+                    }
+                }
+            }
+            Surf::Cylinder { o, a, r, convex: true } => {
+                for sf in surfs.iter().flatten() {
+                    if let Surf::Cylinder { o: o2, a: a2, r: r2, convex: false } = *sf {
+                        let v = o2 - o;
+                        let coaxial = a.cross(a2).len() < 1e-6 && (v - a * v.dot(a)).len() < tol * 100.0;
+                        let wall = r - r2;
+                        if coaxial && wall > tol * 100.0 && wall <= limit {
+                            return Some(wall);
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}
+
+/// Whether any of the faces `standing` shares an edge with a face that is not a plane.
+fn meets_a_round(b: &Body, standing: &[usize], tol: f64) -> bool {
+    let faces: Vec<mt::Face> = b.solid.face_iter().cloned().collect();
+    let round: Vec<usize> = (0..faces.len())
+        .filter(|i| faces.get(*i).is_some_and(|f| !matches!(crate::offset::surf_of(f, tol), Some(crate::offset::Surf::Plane { .. }))))
+        .collect();
+    standing
+        .iter()
+        .filter_map(|i| faces.get(*i))
+        .any(|f| f.edge_iter().any(|e| round.iter().filter_map(|r| faces.get(*r)).any(|g| g.edge_iter().any(|e2| e2.id() == e.id()))))
 }
 
