+        let mut e = [f64::INFINITY, f64::NEG_INFINITY, f64::INFINITY, f64::NEG_INFINITY];
+        for (tri, f) in mesh.triangles.iter().zip(&mesh.tri_face) {
+            if *f as usize != face {
+                continue;
+            }
+            for p in mesh.tri(tri)? {
+                e = [e[0].min(p.dot(u)), e[1].max(p.dot(u)), e[2].min(p.dot(w)), e[3].max(p.dot(w))];
+            }
+        }
+        e[0].is_finite().then_some(e)
