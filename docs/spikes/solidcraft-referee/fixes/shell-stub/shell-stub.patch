+/// Robustness seed 73: a D-shaped block with a box joined on its round wall, shelled open at the
+/// box's underside. The margin-0 cut once produced intersection curves that the tessellator
+/// recursed on without end (66 GB). A body with curved faces keeps the old path: it finishes in
+/// seconds and either refuses or returns a part smaller than the block.
+#[test]
+fn shell_open_underside_of_a_box_on_a_round_wall_terminates() {
+    let slab = box_solid(Vec3::new(0.0, 0.0, 0.0), Vec3::new(45.0, 25.0, 27.5)).unwrap();
+    let round = cylinder(Vec3::new(2.8, 12.5, 0.0), Vec3::Z, 12.8, 27.5).unwrap();
+    let d = boolean(&slab, &round, BoolOp::Union).unwrap().unwrap();
+    let tab = box_solid(Vec3::new(-10.0, 0.0, 12.5), Vec3::new(0.0, 15.0, 25.0)).unwrap();
+    let both = boolean(&d, &tab, BoolOp::Union).unwrap().unwrap();
+    let whole = measure(&both).unwrap().volume;
+    let t = std::time::Instant::now();
+    match shell(&both, &[Vec3::new(-9.92, 14.17, 12.5)], 1.5) {
+        Err(e) => println!("seed73 refused: {e}"),
+        Ok(r) => {
+            let v = measure(&r).unwrap().volume;
+            assert!(v > 0.0 && v < whole, "{v} vs {whole}");
+        }
+    }
+    assert!(t.elapsed().as_secs() < 60, "took {:?}", t.elapsed());
+}
