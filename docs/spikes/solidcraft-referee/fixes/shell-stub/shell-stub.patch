+/// Robustness seed 48: a profile with a hole, a box joined on its top, shelled open at the top.
+/// The box's wall runs down to the open face (cavity worked out by hand: 7141.39 before the cut
+/// box; the shell once cut the wall away to the internal margin and gave 7044.77).
+#[test]
+fn shell_open_top_with_a_box_on_it_keeps_the_wall() {
+    let mut s = Session::default();
+    let steps = [
+        ("sketch.create", json!({"plane": "XY"})),
+        ("sketch.line", json!({"points": [[0, 0], [32.5, 0], [32.5, 32.5], [0, 32.5]]})),
+        ("sketch.arc.three_point", json!({"end": [0, 0], "start": [0, 32.5], "through": [-12.5, 16.25]})),
+        ("sketch.finish", json!({})),
+        ("solid.extrude", json!({"distance": 22.5})),
+        ("solid.hole", json!({"depth": 15.0, "diameter": 4.0, "position": [16.25, 0.0, 11.25]})),
+        ("solid.pattern.circular", json!({"axis": "Z", "count": 2, "features": ["Hole1"]})),
+        ("solid.box", json!({"corner": [-7.5, 22.5, 22.500000000000004], "height": 20.0, "length": 5.0, "operation": "join", "width": 5.0})),
+        ("solid.shell", json!({"faces": [[11.821766724298977, 16.085624724957388, 22.499999999999996]], "thickness": 1.5})),
+        ("solid.box", json!({"corner": [-5.0, 32.5, 27.5], "height": 12.5, "length": 7.5, "operation": "cut", "width": 2.5})),
+    ];
+    for (c, p) in &steps {
+        s.execute(c, p).unwrap_or_else(|e| panic!("{c}: {e}"));
+    }
+    let v = volume(&mut s);
+    assert!((v - 7141.547).abs() < 0.05, "{v}");
+}
+
+/// Bodies where material stands on the opened face and the exact plane-offset path does not
+/// apply (a round face beside it, a torus, a pad lower than the shell is thick): the shell says
+/// so instead of returning a part with the boss cut short (these gave -1.7% to -5.5% before).
+/// Case scripts are lists of solid commands; the shell is the last one.
+fn shell_script(cmds: &str) -> (Session, Result<serde_json::Value, String>) {
+    let steps: Value = serde_json::from_str(cmds).unwrap_or_default();
+    let list = steps.as_array().cloned().unwrap_or_default();
+    let mut s = Session::default();
+    let mut last = Ok(json!(null));
+    for st in &list {
+        let (c, p) = (st["command"].as_str().unwrap_or(""), &st["params"]);
+        last = s.execute(c, p).map_err(|e| e.to_string());
+        if c != "solid.shell" {
+            assert!(last.is_ok(), "{c}: {last:?}");
+        }
+    }
+    (s, last)
+}
