index 0000000000000000000000000000000000000000..530fbb4e2b3b110fcf04131422c8a97cbffcd61d
--- /dev/null
+++ b/apps/solidcraft-web/src/bridge.rs
@@ -0,0 +1,539 @@
+//! REFEREE / DEMO bridge (reshape-cad docs/spikes/solidcraft-referee/phase1). Not a product surface.
+//!
+//! `window.solidcraft = { execute(json) -> Promise<string>, inspect() -> Promise<string> }`, installed only
+//! when the page URL carries `?bridge=<token>` (8+ chars of [A-Za-z0-9_-]). The same two calls are also
+//! served over `postMessage` to the embedding parent frame (see `on_message`), because a host page on
+//! another origin cannot reach this window's JS object.
+//!
+//! Re-entrancy rule: JS only ENQUEUES. Requests are drained in `drain()` from `Shell::logic()`, so the
+//! session is never touched from JS and never borrowed twice.
+use std::cell::RefCell;
+use std::collections::VecDeque;
+
+use serde_json::{Value, json};
+use solidcraft_engine::Session;
+use solidcraft_ui_egui::SolveApp;
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wasm_bindgen::closure::Closure;
+
+/// The only command ids a bridge caller may run. Everything the Phase 0 translator emits
+/// (docs/spikes/solidcraft-referee/phase0/COVERAGE.md); nothing that touches files, export, save, open,
+/// edit history, macros or parameters (the translator emits no parameters.* id).
+const ALLOWED: &[&str] = &[
+    "solid.box", "solid.cylinder", "solid.sphere", "solid.torus", "solid.extrude", "solid.revolve", "solid.loft",
+    "solid.fillet", "solid.chamfer", "solid.shell", "solid.hole", "solid.draft", "solid.mirror", "solid.combine",
+    "solid.move", "solid.pattern.rectangular", "solid.pattern.circular",
+    "sketch.create", "sketch.line", "sketch.arc.three_point", "sketch.circle.center", "sketch.finish",
+    // phase 3: constrained sketches (docs/spikes/solidcraft-referee/phase2/CONSTRAINT-COVERAGE.md). Geometry-only.
+    "sketch.point", "sketch.dimension",
+    "sketch.constraint.coincident", "sketch.constraint.horizontal_vertical", "sketch.constraint.parallel",
+    "sketch.constraint.perpendicular", "sketch.constraint.tangent", "sketch.constraint.equal",
+    "sketch.constraint.symmetry", "sketch.constraint.midpoint", "sketch.constraint.fix",
+];
+const MAX_COMMANDS: usize = 2000;
+
+struct Stash {
+    doc_id: u64,
+    seq: u64,
+    label: String,
+    session: Session,
+}
+const MAX_STASH_PER_DOC: usize = 3;
+const MAX_STASH_TOTAL: usize = 8;
+
+/// For the web shell: the stashed hand work to keep in the autosave slot (so a reload can offer it), if any:
+/// the active design's newest stash, else, when the active design has no unsaved hand work, the newest overall.
+pub fn autosave_stash(app: &SolveApp) -> Option<(solidcraft_engine::doc::Document, Option<String>, u64)> {
+    let active = solidcraft_ui_egui::documents::active_id(app);
+    STASH.with(|s| {
+        let s = s.borrow();
+        let pick = s.iter().rev().find(|e| e.doc_id == active).or_else(|| if app.session.is_dirty() { None } else { s.last() })?;
+        Some((pick.session.design().into_owned(), pick.session.path.clone(), (1u64 << 62) | pick.seq))
+    })
+}
+
+/// Any design set aside (the page must warn before it is left).
+pub fn any_stash() -> bool {
+    STASH.with(|s| !s.borrow().is_empty())
+}
+
+fn has_stash_for(doc_id: u64) -> bool {
+    STASH.with(|s| s.borrow().iter().any(|e| e.doc_id == doc_id))
+}
+
+/// The active design is exactly what a pane run produced (no hand edit since).
+fn produced_untouched(app: &SolveApp) -> bool {
+    let id = solidcraft_ui_egui::documents::active_id(app);
+    RUN_DOC.with(|r| r.borrow().get(&id).is_some_and(|d| std::sync::Arc::ptr_eq(d, &app.session.doc) || **d == *app.session.doc))
+}
+
+enum Kind {
+    Execute(String),
+    Inspect(String),
+}
+
+struct Request {
+    kind: Kind,
+    /// Came through the postMessage relay (token required on every call); false = the page's own JS.
+    relayed: bool,
+    resolve: js_sys::Function,
+    reject: js_sys::Function,
+}
+
+thread_local! {
+    static QUEUE: RefCell<VecDeque<Request>> = const { RefCell::new(VecDeque::new()) };
+    static CTX: RefCell<Option<egui::Context>> = const { RefCell::new(None) };
+    static TOKEN: RefCell<Option<String>> = const { RefCell::new(None) };
+    /// The ONE origin allowed to drive the relay (`?parent=`). No `parent` param: relay disabled.
+    #[allow(dead_code)]
+    static PARENT: RefCell<Option<String>> = const { RefCell::new(None) };
+    /// Phase 6: the user's own designs, set aside by pane runs that asked to keep them. Memory only. Each entry
+    /// is bound to the design (document id) it was taken from; per design at most MAX_STASH_PER_DOC, in total
+    /// MAX_STASH_TOTAL (the oldest of that design goes first, and `inspect` tells the pane before it happens).
+    static STASH: RefCell<Vec<Stash>> = const { RefCell::new(Vec::new()) };
+    /// Per design id: the document a pane run produced, to tell "untouched script result" from "hand-edited".
+    static RUN_DOC: RefCell<std::collections::HashMap<u64, std::sync::Arc<solidcraft_engine::doc::Document>>> = RefCell::new(std::collections::HashMap::new());
+    static SEQ: std::cell::Cell<u64> = const { std::cell::Cell::new(1) };
+}
+
+fn query_param(name: &str) -> Option<String> {
+    let q = web_sys::window()?.location().search().ok()?;
+    let prefix = format!("{name}=");
+    let raw = q.trim_start_matches('?').split('&').find_map(|kv| kv.strip_prefix(prefix.as_str()))?.to_string();
+    js_sys::decode_uri_component(&raw).ok().and_then(|j| j.as_string())
+}
+
+/// Phase 6: the in-page script pane makes its own per-load token (index.html, `?pane=on`) and hands it over as
+/// `window.__sc_pane_token`. It is a switch that keeps the bridge off unless the pane is enabled, not a secret.
+fn token_from_page() -> Option<String> {
+    let w = web_sys::window()?;
+    js_sys::Reflect::get(&w, &"__sc_pane_token".into()).ok()?.as_string()
+}
+
+fn token_from_query() -> Option<String> {
+    // Phase 6: ONLY the in-page pane enables the bridge. The phase 1-5 `?bridge=<token>` URL switch is gone.
+    let t = token_from_page()?;
+    (t.len() >= 8 && t.len() <= 128 && t.chars().all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '-')).then_some(t)
+}
+
+/// Held requests beyond this are refused at once (the queue is drained once per frame).
+const MAX_QUEUED: usize = 64;
+/// A payload longer than this is refused before any JSON parsing.
+const MAX_PAYLOAD: usize = 1_000_000;
+
+fn enqueue(kind: Kind, relayed: bool, resolve: js_sys::Function, reject: js_sys::Function) {
+    let too_big = match &kind { Kind::Execute(t) | Kind::Inspect(t) => t.len() > MAX_PAYLOAD };
+    let full = QUEUE.with(|q| q.borrow().len() >= MAX_QUEUED);
+    if too_big || full {
+        let msg = if too_big { "The request is larger than 1 MB; nothing ran." } else { "The bridge queue is full; nothing ran." };
+        let _ = resolve.call1(&JsValue::NULL, &JsValue::from_str(&reject_msg(msg.into()).to_string()));
+        return;
+    }
+    QUEUE.with(|q| q.borrow_mut().push_back(Request { kind, relayed, resolve, reject }));
+    CTX.with(|c| {
+        if let Some(ctx) = c.borrow().as_ref() {
+            ctx.request_repaint();
+        }
+    });
+}
+
+fn promise(kind: Kind) -> js_sys::Promise {
+    let mut kind = Some(kind);
+    js_sys::Promise::new(&mut |resolve, reject| {
+        if let Some(k) = kind.take() {
+            enqueue(k, false, resolve, reject);
+        }
+    })
+}
+
+/// Install `window.solidcraft` and the postMessage relay. Does nothing without a valid `?bridge=` token.
+pub fn install(ctx: &egui::Context) {
+    let Some(token) = token_from_query() else { return };
+    TOKEN.with(|t| *t.borrow_mut() = Some(token.clone()));
+    CTX.with(|c| *c.borrow_mut() = Some(ctx.clone()));
+    let Some(window) = web_sys::window() else { return };
+    let api = js_sys::Object::new();
+    let exec = Closure::<dyn Fn(String) -> js_sys::Promise>::new(|json: String| promise(Kind::Execute(json)));
+    let insp = Closure::<dyn Fn() -> js_sys::Promise>::new(|| promise(Kind::Inspect(String::new())));
+    let _ = js_sys::Reflect::set(&api, &"execute".into(), exec.as_ref());
+    let _ = js_sys::Reflect::set(&api, &"inspect".into(), insp.as_ref());
+    exec.forget();
+    insp.forget();
+    let _ = js_sys::Reflect::set(&window, &"solidcraft".into(), &api);
+
+    // Phase 6: no postMessage relay. The pane and the app are one page, and the app refuses to be framed
+    // (`frame-ancestors 'none'` from serve.mjs), so there is no second origin to talk to.
+    log::info!("solidcraft bridge installed (referee demo)");
+}
+
+/// postMessage relay: `{solidcraft: 'execute'|'inspect', id, payload}` from the PARENT frame only
+/// (`event.source === window.parent`). The reply goes back to that event's own origin, never `*`.
+#[allow(dead_code)]
+fn on_message(ev: web_sys::MessageEvent) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(Some(parent)) = window.parent() else { return };
+    let from_parent = ev.source().is_some_and(|s| JsValue::from(s) == JsValue::from(parent.clone()));
+    // Both must hold: it is the parent frame AND its origin is exactly the one named in `?parent=`.
+    // Anything else gets no reply at all (not even a refusal), so a stranger learns nothing.
+    let allowed = PARENT.with(|p| p.borrow().as_deref().is_some_and(|want| want == ev.origin()));
+    if !from_parent || !allowed {
+        return;
+    }
+    let data = ev.data();
+    let get = |k: &str| js_sys::Reflect::get(&data, &k.into()).ok();
+    let (Some(what), Some(id)) = (get("solidcraft").and_then(|v| v.as_string()), get("id")) else { return };
+    let payload = get("payload").and_then(|v| v.as_string()).unwrap_or_default();
+    let origin = ev.origin();
+    let reply = {
+        let (parent, origin, id) = (parent.clone(), origin.clone(), id.clone());
+        move |ok: bool, v: JsValue| {
+            let o = js_sys::Object::new();
+            let _ = js_sys::Reflect::set(&o, &"solidcraft_reply".into(), &JsValue::TRUE);
+            let _ = js_sys::Reflect::set(&o, &"id".into(), &id);
+            let _ = js_sys::Reflect::set(&o, &"ok".into(), &JsValue::from_bool(ok));
+            let _ = js_sys::Reflect::set(&o, &"value".into(), &v);
+            let _ = parent.post_message(&o, &origin);
+        }
+    };
+    let reply = std::rc::Rc::new(reply);
+    let (r1, r2) = (reply.clone(), reply);
+    let resolve = Closure::once_into_js(move |v: JsValue| r1(true, v)).unchecked_into::<js_sys::Function>();
+    let reject = Closure::once_into_js(move |v: JsValue| r2(false, v)).unchecked_into::<js_sys::Function>();
+    match what.as_str() {
+        "execute" => enqueue(Kind::Execute(payload), true, resolve, reject),
+        "inspect" => enqueue(Kind::Inspect(payload), true, resolve, reject),
+        _ => {}
+    }
+}
+
+fn token_ok(v: &Value) -> bool {
+    let given = v.get("token").and_then(Value::as_str).unwrap_or("");
+    TOKEN.with(|t| t.borrow().as_deref().is_some_and(|want| want == given))
+}
+
+fn body_list(measure: &Value) -> Value {
+    let names: Vec<Value> = measure
+        .get("bodies")
+        .and_then(Value::as_array)
+        .map(|a| a.iter().filter_map(|b| b.get("name").cloned()).collect())
+        .unwrap_or_default();
+    Value::Array(names)
+}
+
+fn inspect(app: &mut SolveApp) -> Value {
+    match app.session.execute("inspect.measure", &json!({})) {
+        // `dirty`: changed since the last bridge run / save (i.e. by hand); `stashed`: a design is set aside for Restore.
+        Ok(m) => {
+            let active = solidcraft_ui_egui::documents::active_id(app);
+            let stash: Vec<Value> = STASH.with(|s| {
+                s.borrow()
+                    .iter()
+                    .map(|e| {
+                        let tab = solidcraft_ui_egui::documents::tab_of(app, e.doc_id);
+                        json!({"doc_id": e.doc_id, "seq": e.seq, "label": e.label, "tab": tab,
+                               "tab_name": tab.map(|i| solidcraft_ui_egui::documents::tab_name(app, i)), "active": e.doc_id == active})
+                    })
+                    .collect()
+            });
+            let depth = stash.iter().filter(|e| e["active"] == json!(true)).count();
+            json!({"ok": true, "bodies": body_list(&m), "measure": m, "dirty": app.session.is_dirty(),
+                   "stashed": !stash.is_empty(), "stash": stash, "stash_depth_active": depth, "stash_max_per_doc": MAX_STASH_PER_DOC,
+                   "active_doc": active, "active_tab": app.docs.active, "tabs": solidcraft_ui_egui::documents::tabs_info(app).len(),
+                   "produced_untouched": produced_untouched(app)})
+        }
+        Err(e) => json!({"ok": false, "error": e.to_string()}),
+    }
+}
+
+/// Phase 3: the evaluated ACTIVE sketch as solidcraft holds it (solved points/curves, SolveReport with dof / failing /
+/// redundant, profile list with interior points). Read-only; same data the phase 2 `@sketch` pseudo-command dumped.
+fn sketch_snapshot(app: &SolveApp) -> Option<Value> {
+    let f = app.session.active_sketch?;
+    let state = app.session.model.state();
+    let ss = state.sketch(f)?;
+    let profs: Vec<Value> = ss
+        .profiles
+        .iter()
+        .map(|p| {
+            let ip = p.region.interior_point();
+            json!({"outer_curves": p.outer_curves, "hole_curves": p.hole_curves, "area": p.area, "interior": [ip.x, ip.y]})
+        })
+        .collect();
+    Some(json!({
+        "feature": f, "name": ss.name,
+        "report": serde_json::to_value(&ss.report).unwrap_or(Value::Null),
+        "sketch": serde_json::to_value(&ss.sketch).unwrap_or(Value::Null),
+        "profiles": ss.profiles.len(), "profile_list": profs,
+    }))
+}
+
+/// Phase 4: a READ-ONLY snapshot of every body's faces and edges as solidcraft names and measures them
+/// (`model.faces` / `model.edges`: engine-side face centroid, planar normal, area; edge start/mid/end/length and the
+/// persistent `<face>|<face>` name). Only reads; runs after the command list has succeeded; nothing is written back.
+/// Bounded: at most MAX_TOPO_BODIES bodies and MAX_TOPO_ITEMS faces+edges in total, else `truncated: true`.
+const MAX_TOPO_BODIES: usize = 32;
+const MAX_TOPO_ITEMS: usize = 4000;
+fn topology(app: &mut SolveApp, measure: &Value) -> Value {
+    let names: Vec<String> = measure
+        .get("bodies")
+        .and_then(Value::as_array)
+        .map(|a| a.iter().filter_map(|b| b.get("name").and_then(Value::as_str).map(str::to_string)).collect())
+        .unwrap_or_default();
+    let mut out = Vec::new();
+    let world = app.session.world_state();
+    let mut items = 0usize;
+    let mut truncated = names.len() > MAX_TOPO_BODIES;
+    for n in names.iter().take(MAX_TOPO_BODIES) {
+        let p = json!({"body": n});
+        let faces = app.session.execute("model.faces", &p).map(|v| v.get("faces").cloned().unwrap_or(Value::Null));
+        let edges = app.session.execute("model.edges", &p).map(|v| v.get("edges").cloned().unwrap_or(Value::Null));
+        match (faces, edges) {
+            (Ok(mut f), Ok(e)) => {
+                // solidcraft's own pick rule (nearest face within 5% of the body, `face_index_at`) applied to each face's
+                // centroid: which face index a pick AT the centroid would hit, and how far from it. A face with a hole
+                // can have its centroid in the hole; the host refuses such a pick instead of guessing.
+                if let (Some(arr), Some(mb)) = (f.as_array_mut(), world.body(n)) {
+                    // a point that is ON each face by construction: the centroid of its largest display triangle
+                    let m = mb.mesh();
+                    let mut inner: std::collections::HashMap<usize, (f64, [f64; 3])> = std::collections::HashMap::new();
+                    for (t, fi) in m.triangles.iter().zip(&m.tri_face) {
+                        let Some([a, b2, c]) = m.tri(t) else { continue };
+                        let ar = (b2 - a).cross(c - a).len() * 0.5;
+                        let g = (a + b2 + c) * (1.0 / 3.0);
+                        let e = inner.entry(*fi as usize).or_insert((-1.0, [0.0; 3]));
+                        if ar > e.0 {
+                            *e = (ar, [g.x, g.y, g.z]);
+                        }
+                    }
+                    for fv in arr.iter_mut() {
+                        if let Some((_, p)) = fv.get("index").and_then(Value::as_u64).and_then(|i| inner.get(&(i as usize))) {
+                            fv["inner_point"] = json!(p);
+                            let q = serde_json::from_value(json!(p)).ok();
+                            if let Some(q) = q {
+                                if let Some((d, idx)) = solidcraft_doc::appearance::nearest_face(mb, q) {
+                                    fv["inner_hit"] = json!({"index": idx, "dist": d});
+                                }
+                            }
+                        }
+                    }
+                    for fv in arr.iter_mut() {
+                        let c = serde_json::from_value(fv.get("centroid").cloned().unwrap_or(Value::Null)).ok();
+                        if let Some(c) = c {
+                            if let Some((d, idx)) = solidcraft_doc::appearance::nearest_face(mb, c) {
+                                fv["centroid_hit"] = json!({"index": idx, "dist": d});
+                            }
+                        }
+                    }
+                }
+                items += f.as_array().map_or(0, Vec::len) + e.as_array().map_or(0, Vec::len);
+                if items > MAX_TOPO_ITEMS {
+                    truncated = true;
+                    break;
+                }
+                out.push(json!({"name": n, "faces": f, "edges": e}));
+            }
+            (f, e) => out.push(json!({"name": n, "error": format!("{:?} {:?}", f.err().map(|x| x.to_string()), e.err().map(|x| x.to_string()))})),
+        }
+    }
+    json!({"bodies": out, "truncated": truncated})
+}
+
+fn reject_msg(msg: String) -> Value {
+    json!({"ok": false, "rejected": msg})
+}
+
+/// All-or-nothing: validate the whole list first, then run it; the first failure RESTORES the design.
+fn execute(app: &mut SolveApp, text: &str) -> Value {
+    let v: Value = match serde_json::from_str(text) {
+        Ok(v) => v,
+        Err(e) => return reject_msg(format!("The request is not valid JSON ({e}); nothing ran.")),
+    };
+    if !token_ok(&v) {
+        return reject_msg("The bridge token is missing or wrong; nothing ran.".into());
+    }
+    if v.get("restore_previous").and_then(Value::as_bool).unwrap_or(false) {
+        // Put back a design a `keep_previous` run set aside, INTO THE DESIGN IT CAME FROM and nowhere else.
+        let want = v.get("doc_id").and_then(Value::as_u64);
+        let into_new = v.get("into_new_tab").and_then(Value::as_bool).unwrap_or(false);
+        let force = v.get("force").and_then(Value::as_bool).unwrap_or(false);
+        let active = solidcraft_ui_egui::documents::active_id(app);
+        let idx = STASH.with(|s| {
+            let s = s.borrow();
+            match want {
+                Some(d) => s.iter().rposition(|e| e.doc_id == d),
+                None => s.iter().rposition(|e| e.doc_id == active).or_else(|| s.len().checked_sub(1)),
+            }
+        });
+        let Some(idx) = idx else {
+            return reject_msg("There is no earlier design to restore; nothing changed.".into());
+        };
+        let doc_id = STASH.with(|s| s.borrow()[idx].doc_id);
+        let tab = solidcraft_ui_egui::documents::tab_of(app, doc_id);
+        match tab {
+            Some(t) => {
+                let name = solidcraft_ui_egui::documents::tab_name(app, t);
+                let untouched = solidcraft_ui_egui::documents::session_at(app, t).is_some_and(|sess| {
+                    RUN_DOC.with(|r| r.borrow().get(&doc_id).is_some_and(|d| std::sync::Arc::ptr_eq(d, &sess.doc) || **d == *sess.doc))
+                });
+                if !untouched && !force {
+                    return json!({"ok": false, "needs_confirm": true, "tab": t, "tab_name": name,
+                        "sentence": format!("Tab \"{name}\" has changes made after the script run; restoring would replace them. Nothing changed.")});
+                }
+                if t != app.docs.active {
+                    solidcraft_ui_egui::documents::switch(app, t);
+                }
+                let prev = STASH.with(|s| s.borrow_mut().remove(idx)).session;
+                let rev = app.session.revision;
+                app.session = prev;
+                app.session.invalidate_view(rev);
+            }
+            None if into_new => {
+                let prev = STASH.with(|s| s.borrow_mut().remove(idx)).session;
+                if let Err(e) = solidcraft_ui_egui::documents::open_tab(app, prev) {
+                    return reject_msg(format!("Could not open a new tab: {e}; the saved design is still kept."));
+                }
+            }
+            None => {
+                return json!({"ok": false, "origin_closed": true,
+                    "sentence": "The tab this design came from was closed. Nothing changed; restore it into a new tab instead."});
+            }
+        }
+        RUN_DOC.with(|r| r.borrow_mut().remove(&doc_id));
+        app.dialog = None;
+        app.tool = None;
+        app.home.open = false;
+        app.fit_view();
+        let mut out = inspect(app);
+        out["restored_previous"] = json!(true);
+        return out;
+    }
+    let Some(list) = v.get("commands").and_then(Value::as_array) else {
+        return reject_msg("The request has no `commands` array; nothing ran.".into());
+    };
+    if list.len() > MAX_COMMANDS {
+        return reject_msg(format!("The request has {} commands, more than the {MAX_COMMANDS} allowed; nothing ran.", list.len()));
+    }
+    let mut steps = Vec::with_capacity(list.len());
+    for (i, c) in list.iter().enumerate() {
+        let id = c.get("command").and_then(Value::as_str).unwrap_or("");
+        if !ALLOWED.contains(&id) {
+            return reject_msg(format!(
+                "Command {} (`{id}`) is not on the bridge allowlist, so the whole request was refused and nothing ran.",
+                i + 1
+            ));
+        }
+        steps.push((id.to_string(), c.get("params").cloned().unwrap_or(Value::Null)));
+    }
+    let fresh = v.get("fresh").and_then(Value::as_bool).unwrap_or(false);
+    let keep_previous = fresh && v.get("keep_previous").and_then(Value::as_bool).unwrap_or(false);
+    let want_topology = v.get("topology").and_then(Value::as_bool).unwrap_or(false);
+    // Undo point. `fresh` swaps in an empty design (the old Session is kept until the run succeeds);
+    // otherwise a checkpoint of the live one.
+    let mut old: Option<Session> = None;
+    let mut checkpoint: Option<u64> = None;
+    let rev = app.session.revision;
+    // The open dialog and tool are set aside for the run and put back if it fails.
+    let saved_dialog = app.dialog.take();
+    let saved_tool = app.tool.take();
+    if fresh {
+        old = Some(std::mem::take(&mut app.session));
+        app.session.revision = rev + 1;
+    } else {
+        checkpoint = Some(app.session.checkpoint());
+    }
+    let mut results = Vec::with_capacity(steps.len());
+    let mut sketches: Vec<Value> = Vec::new();
+    for (i, (id, params)) in steps.iter().enumerate() {
+        if id == "sketch.finish" {
+            // the sketch is still active here: record its report before it is closed
+            if let Some(s) = sketch_snapshot(app) {
+                sketches.push(s);
+            }
+        }
+        match app.run(id, params.clone()) {
+            Ok(r) => results.push(r),
+            Err(e) => {
+                let at_failure = sketch_snapshot(app);
+                if let Some(prev) = old.take() {
+                    app.session = prev;
+                    app.session.invalidate_view(rev + 1);
+                } else if let Some(cp) = checkpoint {
+                    let _ = app.session.restore_checkpoint(cp);
+                }
+                app.dialog = saved_dialog;
+                app.tool = saved_tool;
+                let now = inspect(app);
+                return json!({"ok": false, "failed": {"index": i, "command": id, "error": e, "params": params}, "restored": true, "measure": now.get("measure"), "sketches": sketches, "sketch_at_failure": at_failure});
+            }
+        }
+    }
+    if let Some(cp) = checkpoint {
+        app.session.drop_checkpoint(cp);
+    }
+    if fresh {
+        app.session.invalidate_view(rev);
+        if keep_previous {
+            // `old` is the design that was on screen before this run (still held, because the run succeeded).
+            if let Some(prev) = old.take() {
+                let doc_id = solidcraft_ui_egui::documents::active_id(app);
+                let seq = SEQ.with(|c| c.replace(c.get() + 1));
+                let label = format!("{} ({} features)", prev.doc.name, prev.doc.features.len());
+                STASH.with(|s| {
+                    let mut s = s.borrow_mut();
+                    while s.iter().filter(|e| e.doc_id == doc_id).count() >= MAX_STASH_PER_DOC {
+                        if let Some(p) = s.iter().position(|e| e.doc_id == doc_id) {
+                            s.remove(p);
+                        }
+                    }
+                    while s.len() >= MAX_STASH_TOTAL {
+                        s.remove(0);
+                    }
+                    s.push(Stash { doc_id, seq, label, session: prev });
+                });
+            }
+        }
+    }
+    // The model is the demo's output: show it (not the start page) and do not leave an "unsaved work"
+    // autosave/beforeunload prompt behind for a design that is regenerated from a script anyway.
+    app.home.open = false;
+    if fresh {
+        let id = solidcraft_ui_egui::documents::active_id(app);
+        RUN_DOC.with(|r| r.borrow_mut().insert(id, app.session.doc.clone()));
+    }
+    // Phase 6: while a design is set aside for this document the result stays UNSAVED, so the page still warns on
+    // reload and the autosave (which holds the stashed hand work) is not cleared.
+    if !has_stash_for(solidcraft_ui_egui::documents::active_id(app)) {
+        app.session.mark_saved();
+    }
+    app.fit_view();
+    match app.session.execute("inspect.measure", &json!({})) {
+        Ok(m) => {
+            let mut out = json!({"ok": true, "results": results, "measure": m, "bodies": body_list(&m), "sketches": sketches});
+            if want_topology {
+                let t = topology(app, &m);
+                out["topology"] = t;
+            }
+            out
+        }
+        Err(e) => json!({"ok": false, "error": format!("ran, but inspect.measure failed: {e}")}),
+    }
+}
+
+/// Run every queued request. Called from `Shell::logic()` only.
+pub fn drain(app: &mut SolveApp) {
+    let pending: Vec<Request> = QUEUE.with(|q| q.borrow_mut().drain(..).collect());
+    for req in pending {
+        let out = match &req.kind {
+            Kind::Execute(text) => execute(app, text),
+            Kind::Inspect(text) => {
+                // the page's own JS (window.solidcraft.inspect()) may call bare; a relayed call must carry the token
+                let ok = (!req.relayed && text.is_empty()) || serde_json::from_str::<Value>(text).is_ok_and(|v| token_ok(&v));
+                if ok { inspect(app) } else { reject_msg("The bridge token is missing or wrong.".into()) }
+            }
+        };
+        let s = JsValue::from_str(&out.to_string());
+        let _ = req.resolve.call1(&JsValue::NULL, &s);
+        let _ = &req.reject; // reject is only for a bridge that cannot answer at all; every outcome resolves with JSON
+    }
+}
