+/// The thickness of a standing wall thinner than twice `t` (or exactly that): the standing face
+/// and a face looking the other way behind it, a plane parallel to it that overlaps it, or a
+/// cylinder coaxial inside it.
+fn thin_standing_wall(b: &Body, mesh: &solidcraft_geom::Mesh, standing: &[usize], t: f64) -> Option<f64> {
+    use crate::offset::{Surf, surf_of};
+    let tol = (b.size() * 1e-6).max(1e-9);
+    let faces: Vec<mt::Face> = b.solid.face_iter().cloned().collect();
+    let surfs: Vec<Option<Surf>> = faces.iter().map(|f| surf_of(f, tol * 100.0)).collect();
+    // Extent of each face in the plane square to `n`.
+    let extent = |face: usize, u: Vec3, w: Vec3| -> Option<[f64; 4]> {
+        let mut e = [f64::INFINITY, f64::NEG_INFINITY, f64::INFINITY, f64::NEG_INFINITY];
+        for (tri, f) in mesh.triangles.iter().zip(&mesh.tri_face) {
+            if *f as usize != face {
+                continue;
+            }
+            for p in mesh.tri(tri)? {
+                e = [e[0].min(p.dot(u)), e[1].max(p.dot(u)), e[2].min(p.dot(w)), e[3].max(p.dot(w))];
+            }
+        }
+        e[0].is_finite().then_some(e)
+    };
+    // Exact: a wall of 2t or less is refused, anything thicker is built (the cut is right just above 2t).
+    let eps = b.size() * 1e-9;
+    let limit = 2.0 * t + eps;
+    for &si in standing {
+        let Some(sf) = surfs.get(si).copied().flatten() else { continue };
+        match sf {
+            Surf::Plane { n, d } => {
+                let (u, w) = (n.any_perp(), n.cross(n.any_perp()));
+                let Some(es) = extent(si, u, w) else { continue };
+                for (oi, o) in surfs.iter().enumerate() {
+                    let Some(Surf::Plane { n: n2, d: d2 }) = *o else { continue };
+                    let wall = d + d2;
+                    if oi == si || n2.dot(n) > -1.0 + 1e-9 || wall <= eps || wall > limit {
+                        continue;
+                    }
+                    let Some(eo) = extent(oi, u, w) else { continue };
+                    let overlap = |a: (f64, f64), c: (f64, f64)| a.1.min(c.1) - a.0.max(c.0) > tol * 100.0;
+                    if overlap((es[0], es[1]), (eo[0], eo[1])) && overlap((es[2], es[3]), (eo[2], eo[3])) {
+                        return Some(wall);
+                    }
+                }
+            }
+            Surf::Cylinder { o, a, r, convex: true } => {
+                for sf in surfs.iter().flatten() {
+                    if let Surf::Cylinder { o: o2, a: a2, r: r2, convex: false } = *sf {
+                        let v = o2 - o;
+                        let coaxial = a.cross(a2).len() < 1e-6 && (v - a * v.dot(a)).len() < tol * 100.0;
+                        let wall = r - r2;
+                        if coaxial && wall > eps && wall <= limit {
+                            return Some(wall);
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}
+
+/// The width of a ligament narrower than twice `t` between a round hole and a wall parallel to
+/// its axis, or between two parallel round holes: the hole's wall moves out by `t` into the
+/// material and the other side moves in by `t`, and where they are closer than `2t` the offsets
+/// cross, which the topology-keeping offset does not see (the cavity then comes out too small).
+/// A ligament of exactly `2t` is fine (measured).
+fn thin_web(b: &Body, mesh: &solidcraft_geom::Mesh, opened: &[usize], t: f64) -> Option<f64> {
+    use crate::offset::{Surf, surf_of};
+    let tol = (b.size() * 1e-6).max(1e-9);
+    let eps = b.size() * 1e-9;
+    let faces: Vec<mt::Face> = b.solid.face_iter().cloned().collect();
+    let surfs: Vec<Option<Surf>> = faces.iter().map(|f| surf_of(f, tol * 100.0)).collect();
+    if faces.len() > 2000 {
+        return None;
+    }
+    let extent = |face: usize, u: Vec3, w: Vec3| -> Option<[f64; 4]> {
+        let mut e = [f64::INFINITY, f64::NEG_INFINITY, f64::INFINITY, f64::NEG_INFINITY];
+        for (tri, f) in mesh.triangles.iter().zip(&mesh.tri_face) {
+            if *f as usize != face {
+                continue;
+            }
+            for p in mesh.tri(tri)? {
+                e = [e[0].min(p.dot(u)), e[1].max(p.dot(u)), e[2].min(p.dot(w)), e[3].max(p.dot(w))];
+            }
+        }
+        e[0].is_finite().then_some(e)
+    };
+    let overlap = |a: (f64, f64), c: (f64, f64)| a.1.min(c.1) - a.0.max(c.0) > tol * 100.0;
+    let thin = |web: f64| web > eps && web < 2.0 * t - eps;
+    for (hi, hs) in surfs.iter().enumerate() {
+        let Some(Surf::Cylinder { o, a, r, convex: false }) = *hs else { continue };
+        let v_dir = a.any_perp();
+        for (oi, os) in surfs.iter().enumerate() {
+            match *os {
+                // A wall parallel to the hole's axis, with material between.
+                Some(Surf::Plane { n, d }) if !opened.contains(&oi) && n.dot(a).abs() < 1e-6 => {
+                    let web = d - n.dot(o) - r;
+                    if !thin(web) {
+                        continue;
+                    }
+                    let tangent = n.cross(a);
+                    let (Some(eh), Some(ep)) = (extent(hi, a, tangent), extent(oi, a, tangent)) else { continue };
+                    let c = o.dot(tangent);
+                    if overlap((eh[0], eh[1]), (ep[0], ep[1])) && overlap((c - r, c + r), (ep[2], ep[3])) {
+                        return Some(web);
+                    }
+                }
+                // Another parallel hole.
+                Some(Surf::Cylinder { o: o2, a: a2, r: r2, convex: false }) if oi > hi && a.cross(a2).len() < 1e-6 => {
+                    let v = o2 - o;
+                    let perp = (v - a * v.dot(a)).len();
+                    let web = perp - r - r2;
+                    if !thin(web) {
+                        continue;
+                    }
+                    let (Some(e1), Some(e2)) = (extent(hi, a, v_dir), extent(oi, a, v_dir)) else { continue };
+                    if overlap((e1[0], e1[1]), (e2[0], e2[1])) {
+                        return Some(web);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+    None
+}
