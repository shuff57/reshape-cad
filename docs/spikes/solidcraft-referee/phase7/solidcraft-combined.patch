+            r#"[{"command":"solid.box","params":{"length":40,"width":30,"height":10,"center":[0,0,0],"body_name":"b1"}},{"command":"solid.cylinder","params":{"radius":2,"height":20,"base":[-8,-6,-10],"body_name":"h1"}},{"command":"solid.combine","params":{"target":"b1","tools":["h1"],"operation":"cut"}},{"command":"solid.cylinder","params":{"radius":4,"height":3,"base":[-8,-6,3],"body_name":"h2"}},{"command":"solid.combine","params":{"target":"b1","tools":["h2"],"operation":"cut"}},{"command":"solid.shell","params":{"faces":[[0,8,-5]],"thickness":1,"body":"b1"}}]"#,
+            2424.0 + 49.0 * std::f64::consts::PI,
+            1e-5,
+        ),
+        (
+            "n17b box joined on a cylinder wall, cylinder top open: outer - cylinder cavity - box cavity, integrated",
+            r#"[{"command":"solid.cylinder","params":{"radius":15,"height":30,"base":[0,0,0],"body_name":"b1"}},{"command":"solid.box","params":{"length":14,"width":10,"height":10,"center":[19,0,15],"body_name":"b2"}},{"command":"solid.combine","params":{"target":"b1","tools":["b2"],"operation":"join"}},{"command":"solid.shell","params":{"faces":[[0,0,30]],"thickness":1,"body":"b1"}}]"#,
+            3760.8537,
+            1e-5,
+        ),
+        (
+            "n7 boss touching the open face at one vertex: plate shell 2424 + a closed hollow boss 8^3 - 6^3",
+            r#"[{"command":"solid.box","params":{"length":40,"width":30,"height":10,"center":[0,0,0],"body_name":"b1"}},{"command":"solid.box","params":{"length":8,"width":8,"height":8,"center":[24,19,9],"body_name":"b2"}},{"command":"solid.combine","params":{"target":"b1","tools":["b2"],"operation":"join"}},{"command":"solid.shell","params":{"faces":[[0,0,5]],"thickness":1,"body":"b1"}}]"#,
+            2720.0,
+            1e-6,
+        ),
+    ] {
+        let (mut s, r) = shell_script(cmds);
+        assert!(r.is_ok(), "{name}: {r:?}");
+        let v = volume(&mut s);
+        assert!((v - want).abs() < tol * want, "{name}: {v} vs {want}");
