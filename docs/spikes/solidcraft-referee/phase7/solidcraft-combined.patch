+    // the coincidence (2, S10: dof 4) or the point on the line (1, S2b: dof 5).
+    let mut rng = Lcg(2024);
+    for tied in [true, false] {
+        for amp in [0.0, 0.01, 0.05, 0.5, 1.0] {
+            let mut j = [0.0; 8];
+            for x in &mut j {
