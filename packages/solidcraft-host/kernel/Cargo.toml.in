# Template: build.sh fills in @SC_SRC@ (the pinned, UNMODIFIED SolidCraft 0.30.1 source tree, v0.30.1 = 8e2b0cd6). Same wrapper as docs/spikes/solidcraft-referee/wrapper,
# but built with upstream's own release profile (opt-level 3): the spike's wrapper used opt-level "z", which measured ~15x slower than the web build
# (44 s against 2.9 s for the same four countersunk holes, on 0.21.0), too slow to stand in for the page in a time budget. It also lists upstream's root [patch]
# block, which the spike's wrapper did not (the spike's referee was therefore built against stock truck-geometry). That pair is what "corrected" meant at 0.21.0.
#
# The profile and the [patch] block are upstream v0.30.1's, verbatim; build.sh also copies upstream's Cargo.lock in. Upstream's `debug = "line-tables-only"`
# does not reach the wasm as debug info (wasm-bindgen drops DWARF): with `debug = false` the wasm is 0.02% smaller and its code differs slightly, so the profile stays
# upstream's (measured 2026-11-09, packages/solidcraft-host/README.md, "Pin").
[package]
name = "solidcraft-referee"
version = "0.0.0"
edition = "2021"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
solidcraft-engine = { path = "@SC_SRC@/crates/engine" }
solidcraft-doc = { path = "@SC_SRC@/crates/doc" }
serde_json = "1"
wasm-bindgen = "=0.2.129"

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 16
debug = "line-tables-only"

# [patch] is honoured only from the root manifest: upstream v0.30.1's root block, verbatim (paths filled in), otherwise the build silently uses stock upstream truck.
# The last three are UI crates the engine does not use (cargo says "not used in the crate graph"); they are listed so the block stays upstream's verbatim.
[patch.crates-io]
truck-geometry = { path = "@SC_SRC@/vendor/truck-geometry" }
truck-shapeops = { path = "@SC_SRC@/vendor/truck-shapeops" }
truck-stepio = { path = "@SC_SRC@/vendor/truck-stepio" }
truck-meshalgo = { path = "@SC_SRC@/vendor/truck-meshalgo" }
matext4cgmath = { path = "@SC_SRC@/vendor/matext4cgmath" }
egui-wgpu = { path = "@SC_SRC@/vendor/egui-wgpu" }
winit = { path = "@SC_SRC@/vendor/winit" }
accesskit_macos = { path = "@SC_SRC@/vendor/accesskit_macos" }

[workspace]
